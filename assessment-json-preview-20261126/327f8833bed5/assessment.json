 "assessment": {
  "name": "Adult ADHD Observer-Report Scale (ASRS-O)",
  "short_name": null,
  "language": "en",
  "description": "The Adult ADHD Observer-Report Scale (ASRS-O) is an 18-item informant-report questionnaire for mental health clinicians assessing adults (aged 18+) for attention-deficit/hyperactivity disorder. It is completed by someone who knows the adult well; such as a partner, parent, other close relative, or friend, or by a clinician or other professional who has had regular opportunity to observe the adult over the past 6 months.",
  "respondent_type": null,
  "source_provider": "NovoPsych",
