 "interpretationRules": [
  {
   "id": "interpret_total_below",
   "when": {
    "expression": "metric_total >= 0 && metric_total <= 5",
    "description": "Total score is below the clinical cut-off."
   },
   "template": "The AIS total score is {metric_total} out of 24 and is below the clinical cut-off of 6.",
   "sourceRef": "source_assessment_page#AIS-Cut-Off-and-Descriptors",
   "reviewStatus": "extracted"
  },
  {
   "id": "interpret_total_elevated",
   "when": {
    "expression": "metric_total >= 6 && metric_total <= 9",
    "description": "Total score is a positive screen in the Elevated range."
   },
   "template": "The AIS total score is {metric_total} out of 24, at or above the clinical cut-off of 6, and falls in the Elevated range.",
   "sourceRef": "source_assessment_page#AIS-Cut-Off-and-Descriptors",
   "reviewStatus": "extracted"
  },
  {
   "id": "interpret_total_highly_elevated",
   "when": {
    "expression": "metric_total >= 10 && metric_total <= 24",
    "description": "Total score is a positive screen in the Highly elevated range."
   },
   "template": "The AIS total score is {metric_total} out of 24, above the clinical cut-off of 6, and falls in the Highly elevated range.",
   "sourceRef": "source_assessment_page#AIS-Cut-Off-and-Descriptors",
   "reviewStatus": "extracted"
  },
  {
   "id": "interpret_sleep_domain",
   "when": {
    "expression": "metric_sleep_difficulty != null",
    "description": "A complete Sleep Difficulty domain score is available."
   },
   "template": "Sleep Difficulty has an average item score of {metric_sleep_difficulty} out of 3, based on items 1 to 5.",
   "sourceRef": "source_assessment_page#Interpreting-the-AIS-Domain-Scores",
   "reviewStatus": "extracted"
  },
  {
   "id": "interpret_daytime_domain",
   "when": {
    "expression": "metric_daytime_consequences != null",
    "description": "A complete Daytime Consequences domain score is available."
   },
   "template": "Daytime Consequences has an average item score of {metric_daytime_consequences} out of 3, based on items 6 to 8.",
   "sourceRef": "source_assessment_page#Interpreting-the-AIS-Domain-Scores",
   "reviewStatus": "extracted"
  },
  {
   "id": "interpret_domain_comparison",
   "when": {
    "expression": "metric_sleep_difficulty != null && metric_daytime_consequences != null",
    "description": "Both domain scores are available for relative comparison; neither domain has a validated cut-off."
   },
   "template": "Compare the two domain averages descriptively. Do not apply a domain cut-off or percentile; the total score remains the primary interpretation index.",
   "sourceRef": "source_assessment_page#Interpreting-the-AIS-Domain-Scores",
   "reviewStatus": "extracted"
  },
  {
   "id": "interpret_change",
   "when": {
    "expression": "administrationCount >= 2",
    "description": "At least two compatible administrations are available."
   },
   "template": "The total score changed by {current.metric_total - baseline.metric_total} points from baseline. Report movement across the cut-off separately. No reliable-change classification is applied.",
   "sourceRef": "source_assessment_page#AIS-Graphs-and-Change-Over-Time",
   "reviewStatus": "extracted"
  }
 ],
