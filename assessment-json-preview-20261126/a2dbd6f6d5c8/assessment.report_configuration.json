  "sourceGuidance": [
   {
    "title": "VOCI Scoring & Interpretation",
    "text": "T he VOCI total score ranges from 0 to 220, where respondents rate how true each item is of them, with higher scores representing greater overall current OCD symptom severity. The total score should be interpreted alongside subscale scores to understand symptom heterogeneity.\n",
    "source_url": null
   },
