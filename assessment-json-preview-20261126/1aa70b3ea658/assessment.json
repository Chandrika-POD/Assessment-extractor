 "assessment": {
  "name": "Why Have Sex? Questionnaire Short Form (YSEX-SF)",
  "short_name": null,
  "language": "en",
  "description": "The Why Have Sex? Questionnaire Short Form (YSEX-SF) is a 28-item self-report measure of sexual motivation for adults aged 18 years and over (Meston et al., 2020). It assesses the reasons a person has engaged in sex, capturing how frequently each of 14 distinct motivations has led them to have sexual intercourse across their past sexual experiences. For respondents who have not previously had sex, the measure instead assesses the likelihood that each motivation would lead them to have sex.",
  "respondent_type": null,
  "source_provider": "NovoPsych",
  "reference_period": {
   "structured": null,
   "instruction_claims": [],
   "status": "requires_review"
  },
  "target_population": null,
  "intended_uses": null,
  "estimated_administration_minutes": null
 },
 "administration": {
  "instructions": "People have sex (i.e., sexual intercourse) for many different reasons. Below is a list of some of these reasons. Please indicate how frequently each of the following reasons led you to have sex in the past. If you have not had sex in the past, use the scale to indicate the likelihood that each of the following reasons would lead you to have sex. I have had sex in the past because… Response scale (same for every item): 1 = None of my sexual experiences; 2 = A few of my sexual experiences; 3 = Some of my sexual experiences; 4 = Many of my sexual experiences; 5 = All of my sexual experiences.",
  "instructions_source": {
   "url": null,
   "sha256": "bcaf07c2e29e15537e3e879c7f8ec906d7f845d348564c6f2960c3da1fd90fb0",
