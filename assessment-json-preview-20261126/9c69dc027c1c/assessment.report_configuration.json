 "interpretationRules": {
  "encodedRules": [],
  "sourceGuidance": [
   {
    "title": "CSI-16 Scoring & Interpretation",
    "text": "The Couples Satisfaction Index (CSI-16) yields a total score ranging from 0 to 81, with higher scores indicating greater relationship satisfaction.\n\nResearch shows that scores below 51.5 indicate significant relationship dissatisfaction (Funk & Rogge, 2007). This cut-off was empirically derived to distinguish dissatisfied from satisfied couples.\n\nWhen both partners complete the measure, comparing scores can reveal important discrepancies in relationship perceptions that may warrant clinical attention. Large differences between partner scores may indicate areas where relationship experiences diverge significantly.\n",
    "source_url": null
   }
  ],
  "reportScoringGuidance": [
   {
    "documentSha256": "70f410b7e9c34194d24cdc02b5c8104c73723107be5b89d2261bb9f827323118",
    "pageNumber": 1,
    "text": "For comprehensive information on the Couples Satisfaction Index (CSI-16), \nsee here\n.\nThe Couples Satisfaction Index (CSI-16) yields a total score ranging from 0 to 81, with higher\nscores indicating greater relationship satisfaction.",
    "usage": "source_guidance_for_review_not_executable_scoring",
    "runtimeEnabled": false
   }
  ],
  "sourceRequirements": [
   "This cut-off was empirically derived to distinguish dissatisfied from satisfied couples."
  ],
