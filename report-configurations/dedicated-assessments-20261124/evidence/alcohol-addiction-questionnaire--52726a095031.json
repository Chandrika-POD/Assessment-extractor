direction":[1.0,0.0]},{"text":"based upon prior research. Scores of 10 or less are considered to","bbox":[187.41733,492.69931,507.17633,507.81332],"origin":[187.41733,504.52432],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"be \"low dependence\" for males and scores of 5 or less for females","bbox":[187.41733,504.79926,510.09137,519.91327],"origin":[187.41733,516.62427],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"(Raistrick et al., 2014; note that 8 or less is chosen if no gender was","bbox":[187.41733,516.89929,517.57147,532.01331],"origin":[187.41733,528.7243],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"specified but this should be interpreted with caution) whereas scores","bbox":[187.41733,528.99933,520.61829,544.11334],"origin":[187.41733,540.82434],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"between 11 (or 6 or 9, depending upon gender) and 20 are","bbox":[187.41733,541.0993,473.59332,556.21332],"origin":[187.41733,552.92432],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"considered to be \"moderate dependence\" and scores above 20 are","bbox":[187.41733,553.19928,513.79834,568.31329],"origin":[187.41733,565.02429],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"considered \"high dependence\" (Patton-Simpson & MacKinnon,","bbox":[187.41733,565.29926,492.9863,580.41327],"origin":[187.41733,577.12427],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"1999).  ","bbox":[187.41733,577.39929,224.71831,592.51331],"origin":[187.41733,589.2243],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Given that a reliable change score of 4 was determined by Raistrick","bbox":[187.41733,601.5993,516.32825,616.71332],"origin":[187.41733,613.42432],"font":"Helvetica","size":11.0,"colour":"#000000","dir