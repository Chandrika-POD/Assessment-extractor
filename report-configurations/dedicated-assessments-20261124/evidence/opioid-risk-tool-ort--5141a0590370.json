01,519.36438,373.50702],"origin":[187.41733,370.21802],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"indicating that their risk of engaging in aberrant behaviours is","bbox":[187.41733,370.49301,483.94427,385.60703],"origin":[187.41733,382.31802],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"approximately 91 per cent.","bbox":[187.41733,382.59299,317.03033,397.707],"origin":[187.41733,394.418],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[74.03149,409.18625,329.95145,428.46426],"origin":[74.03149,424.16626],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scores range from 0 to 26, with scores calculated differently","bbox":[187.41733,429.27875,479.03836,444.39276],"origin":[187.41733,441.10376],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"dependent on gender and age.The scores are categorized into three","bbox":[187.41733,441.37875,520.05737,456.49277],"origin":[187.41733,453.20377],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"risk categories. ","bbox":[187.41733,453.47876,264.43933,468.59277],"origin":[187.41733,465.30377],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-","bbox":[187.41733,477.67874,191.08032,492.79276],"origin":[187.41733,489.50375],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"\tLow Risk= Scores 0-3","bbox":[191.08032,477.67874,301.4213,492.79276],"origin":[191.08032,489.50375],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-","bbox":[187.41733,489.77875,191.08032,504.89276],"origin":[187.41733,501.60376],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"\tModerate Risk = scores 4 – 7","bbox":[191.08032,489.77875,337.50137,504.89276],"origin":[191.08032,501.60376],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-","bbox":[187.41733,501.87872,191.08032,516.99274],"origin":[187.41733,513.70374],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"\tHigh risk = Scores 8 or more","bbox":[191.08032,501.87872,333.81631,516.99274],"origin":[191.08032,513.70374],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"According to the validation sample (Webster, 2005) patients in the","bbox":[187.41733,526.07874,508.39734,541.19275],"origin":[187.41733,537.90375],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"low risk category have a 5.6% chance of developing one or more","bbox":[187.41733,538.17877,502.89734,553.29279],"origin":[187.41733,550.00378],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"aberrant behaviour when prescribed opioids. The moderate risk","bbox":[187.41733,550.27875,496.15424,565.39276],"origin":[187.41733,562.10376],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"category had a risk of 28% while the high risk category had a risk of","bbox":[187.41733,562.37872,516.33936,577.49274],"origin":[187.41733,574.20374],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"91%. Note that these percentages are not direct measures of risk of","bbox":[187.41733,574.47876,516.96643,589.59277],"origin":[187.41733,586.30377],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"opioid abuse or dependence, but rather aberrant behaviours (which","bbox":[187.41733,586.57874,515.14032,601.69275],"origin":[187.41733,598.40375],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"are known to be associated with abuse and dependence). Aberrant","bbox":[187.41733,598.67877,513.9303,613.79279],"origin":[187.41733,610.50378],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"behaviours are defined as:","bbox":[187.41733,610.77875,317.04132,625.89276],"origin":[187.41733,622.60376],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Used additional opioids than those prescribed","bbox":[187.41733,634.97876,413.63229,650.09277],"origin":[187.41733,646.80377],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Used additional opioids than those prescribed more than once","bbox":[187.41733,647.07874,493.11832,662.19275],"origin":[187.41733,658.90375],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Forged prescription","bbox":[187.41733,659.17877,285.83426,674.29279],"origin":[187.41733,671.00378],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Sold prescription","bbox":[187.41733,671.27875,272.99728,686.39276],"origin":[187.41733,683.10376],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Admitted to seeking euphoria from opioids","bbox":[187.41733,683.37872,396.50525,698.49274],"origin":[187.41733,695.20374],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Admitted to wanting opioids for anxiety","bbox":[187.41733,695.47876,379.38928,710.59277],"origin":[187.41733,707.30377],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Overdose and death","bbox":[187.41733,707.57874,290.75131,722.69275],"origin":[187.41733,719.40375],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Injected drug","bbox":[187.41733,719.67877,254.6713,734.79279],"origin":[187.41733,731.50378],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Abnormal urine/blood screen","bbox":[187.41733,731.77875,331.6933,746.89276],"origin":[187.41733,743.60376],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]