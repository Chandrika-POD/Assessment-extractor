":[432.55899,382.39825,462.12698,389.39825],"colour":"#b03a2e","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"Severe","bboxPt":[439.95117,325.69824,462.12717,332.69824],"colour":"#b03a2e","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"Percentiles","bboxPt":[466.505,297.35828,501.12698,304.35828],"colour":"#999999","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"50th","bboxPt":[465.505,437.48828,479.12701,444.48828],"colour":"#999999","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"80th","bboxPt":[465.505,375.21838,479.12701,382.21838],"colour":"#999999","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"90th","bboxPt":[465.505,352.15817,479.12701,359.15817],"colour":"#999999","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"95th","bboxPt":[465.505,342.61835,479.12701,349.61835],"colour":"#999999","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"99th","bboxPt":[465.505,325.69806,479.12701,332.69806],"colour":"#999999","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"Total","bboxPt":[314.01199,505.26019,336.24197,515.26019],"colour":"#333333","font":"Helvetica","fontSizePt":10.0,"direction":[1.0,0.0]},{"text":"Interpretation","bboxPt":[34.3465,538.10376,124.57652,552.10376],"colour":"#000000","font":"Helvetica-Bold","fontSizePt":14.0,"direction":[1.0,0.0]},{"text":"The respondent’s GAD-7 total score is in the ‘None-Minimal’ range indicating low levels of","bboxPt":[91.0394,557.34796,526.91425,568.34796],"colour":"#000000","font":"Helvetica","fontSizePt":11.0,"direction":[1.0,0.0]}],"backgroundBands":[{"bboxPt":[188.127,451.53702,463.12701,498.78702],"colour":"#ffffff","opacity":0.2,"semantics":"visual_background_only_not_a_scoring_threshold"},{"bboxPt":[188.127,404.28699,463.12701,451.53702],"colour":"#ffff00","opacity":0.2,"semantics":"visual_background_only_not_a_scoring_threshold"},{"bboxPt":[188.127,357.047,463.12701,404.297],"colour":"#ffa500","opacity":0.2,"semantics":"visual_background_only_not_a_scoring_threshold"},{"bboxPt":[188.127,300.34698,463.12701,357.047],"colour":"#ff0000","opacity":0.2,"semantics":"visual_background_only_not_a_scoring_threshold"}],"series":[{"label":"Total","colour":"#000000","sampleDrawingIndex":93,"sourceMarkBBoxPt":[302.62701,470.43701,347.62701,498.78702],"categoryPosition":0.5000000182481744,"barThicknessPt":45.0,"sampleValuePolicy":"evidence_only_never_runtime_input"}],"detection":{"method":"independent_axis_pair","reviewStatus":"machine_observed_not_visually_verified"},"sampleVisitCount":null,"variantEvidence":"single_visit_or_unspecified","drawingEvidence":{"axisDrawingIds":[95,97],"marks":[{"drawingIndex":93,"bboxPt":[302.62701,470.43701,347.62701,498.78702],"colour":"#000000","fill":null,"stroke":"#000000","lineWidthPt":1.0}],"curves":[]}}]},{"pageId":"df9c0c442c439_p2","documentSha256":"f9c0c442c43925ec87e2cb1b46b9315a3b187a7941ca9d40e8494fe0fda21414","pageNumber":2,"text":[{"text":"Client Name","bbox":[66.3844,116.32253,135.73239,128.32253],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Generic Client","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information (cont.)","bbox":[34.3465,144.0488,336.92838,158.0488],"origin":[34.3465,154.85504],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Approximately 11% of individuals under 30 fall into the \"severe\" anxiety range, whereas 1.4% of","bbox":[91.0394,163.29251,556.17444,174.29251],"origin":[91.0394,171.79199],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"people over 70 years of age have scores in that range.","bbox":[91.0394,175.39249,357.01938,186.39249],"origin":[91.0394,183.89197],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Given that experiencing anxiety is common, anxiety is best considered on a dimensional basis","bbox":[91.0394,199.5925,548.34241,210.5925],"origin":[91.0394,208.09198],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"(e.g. the degree to which someone has symptoms) rather than in a binary absent/present","bbox":[91.0394,211.69247,523.91144,222.69247],"origin":[91.0394,220.19196],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"fashion.","bbox":[91.0394,223.79245,129.56139,234.79245],"origin":[91.0394,232.29193],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The scale classifies individuals into distinct severity categories based on their raw scores, as","bbox":[91.0394,247.99246,540.36743,258.99246],"origin":[91.0394,256.49194],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"follows:","bbox":[91.0394,260.09244,127.71339,271.09244],"origin":[91.0394,268.59192],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-None-Minimal (Scores of 4 or below): Scores within this range suggest minimal anxiety, with","bbox":[91.0394,284.29245,542.17133,295.29245],"origin":[91.0394,292.79193],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"symptoms being either absent or so slight that they have little to no impact on daily functioning.","bbox":[91.0394,296.39243,552.03857,307.39243],"origin":[91.0394,304.89191],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Mild (Scores between 5 and 9): Anxiety is present and noticeable but generally manageable,","bbox":[91.0394,320.59244,544.08545,331.59244],"origin":[91.0394,329.09192],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"with only occasional interference in daily activities.","bbox":[91.0394,332.69244,335.56934,343.69244],"origin":[91.0394,341.19193],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Moderate (Scores between 10 and 14): Anxiety symptoms are frequent and intense, potentially","bbox":[91.0394,356.89246,555.7016,367.89246],"origin":[91.0394,365.39194],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"affecting the individual's ability to perform daily tasks effectively. They are more likely than not to","bbox":[91.0394,368.99246,558.3855,379.99246],"origin":[91.0394,377.49194],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"have a diagnosable anxiety disorder such as generalised anxiety disorder.","bbox":[91.0394,381.09247,451.76233,392.09247],"origin":[91.0394,389.59195],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-Severe (Scores of 15 and above): Anxiety symptoms are intense and persistent, significantly","bbox":[91.0394,405.29248,544.06348,416.29248],"origin":[91.0394,413.79196],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"disrupting daily functioning. They likely have a diagnosable anxiety disorder or other psychiatric","bbox":[91.0394,417.39249,553.84241,428.39249],"origin":[91.0394,425.89197],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"condition.","bbox":[91.0394,429.49249,138.11938,440.49249],"origin":[91.0394,437.99197],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"When administered multiple times, the total scores are graphed over time.","bbox":[91.0394,453.6925,450.50842,464.6925],"origin":[91.0394,462.19199],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"A significant change in score is defined as an increase or decrease of at least 6 points. This","bbox":[91.0394,477.89252,536.14343,488.89252],"origin":[91.0394,486.392],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"criterion is based on the Reliable Change Index (Bischoff et al., 2020). Such changes indicate","bbox":[91.0394,489.99252,545.93353,500.99252],"origin":[91.0394,498.492],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"significant change symptoms, while a change of less than the specified points indicates minimal","bbox":[91.0394,502.09253,555.67957,513.09253],"origin":[91.0394,510.59201],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"change in symptom severity between assessments.","bbox":[91.0394,514.19257,342.30136,525.19257],"origin":[91.0394,522.69202],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scores of 10 or greater are indicative of Generalised Anxiety Disorder (Sensitivity 89% and","bbox":[91.0394,538.39258,532.4364,549.39258],"origin":[91.0394,546.89203],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Specificity 82%) (Spitzer et al., 2006) and other psychiatric disorders involving anxiety. Scores of","bbox":[91.0394,550.49261,560.55237,561.49261],"origin":[91.0394,558.99207],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"10 or more may also indicate panic disorder (sensitivity 74%, specificity 81%), social anxiety","bbox":[91.0394,562.59259,538.51935,573.59259],"origin":[91.0394,571.09204],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"disorder (sensitivity 72%, specificity 80%), and post-traumatic stress disorder (sensitivity 66%,","bbox":[91.0394,574.69257,547.67139,585.69257],"origin":[91.0394,583.19202],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"specificity 81%) (Kroenke, et al. 2007).","bbox":[91.0394,586.7926,279.33737,597.7926],"origin":[91.0394,595.29205],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Higher scores on the GAD-7 indicate the presence of anxiety symptoms, however 90% of","bbox":[91.0394,610.99261,525.11047,621.99261],"origin":[91.0394,619.49207],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"individuals with GAD experience at least one additional psychiatric condition over their lifetime.","bbox":[91.0394,623.09259,550.77344,634.09259],"origin":[91.0394,631.59204],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"While major depressive disorder (MDD) is the most prevalent comorbidity among individuals","bbox":[91.0394,635.19263,538.48639,646.19263],"origin":[91.0394,643.69208],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"with GAD, dysthymia, bipolar, alcohol abuse are also frequently observed (Simon, 2009; Preti et","bbox":[91.0394,647.2926,557.51636,658.2926],"origin":[91.0394,655.79205],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"al., 2015).","bbox":[91.0394,659.39264,139.95638,670.39264],"origin":[91.0394,667.89209],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Responses","bbox":[34.3464,698.9342,151.8204,712.9342],"origin":[34.3464,709.74048],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 2 of 3","bbox":[510.23642,809.9267,561.38654,819.9267],"origin":[510.23642,817.6535],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[],"chartObservations":[]},{"pageId":"df9c0c442c439_p3","documentSha256":"f9c0c442c43925ec87e2cb1b46b9315a3b187a7941ca9d40e8494fe0fda21414","pageNumber":3,"text":[{"text":"Client Name","bbox":[66.3844,116.32253,135.73239,128.32253],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Generic Client","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","directi