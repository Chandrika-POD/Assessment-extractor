22623,366.90591,160.34622,376.90591],"origin":[149.22623,374.63272],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"20","bbox":[149.22623,349.4559,160.34622,359.4559],"origin":[149.22623,357.18271],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"22","bbox":[149.22623,331.9957,160.34622,341.9957],"origin":[149.22623,339.7225],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"24","bbox":[149.22623,314.54572,160.34622,324.54572],"origin":[149.22623,322.27252],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"Interpretation","bbox":[34.3465,556.51855,124.57652,570.51855],"origin":[34.3465,567.33606],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The Extreme Demand Avoidance – 8 (EDA-8) questionnaire was administered on 03 December","bbox":[91.0394,575.77405,556.2735,586.77405],"origin":[91.0394,584.2735],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"2025 and the young person's total score was 19.","bbox":[91.0394,587.87408,327.33035,598.87408],"origin":[91.0394,596.37354],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[34.3464,616.79041,290.26636,630.79041],"origin":[34.3464,627.60791],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"For comprehensive information on the Extreme Demand Avoidance - 8 (EDA-8) questionnaire, ","bbox":[91.0393,636.04596,553.21539,647.04596],"origin":[91.0393,644.54541],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"see here","bbox":[91.0395,648.14557,133.84048,659.14557],"origin":[91.0395,656.64502],"font":"Helvetica","size":11.0,"colour":"#0000ff","direction":[1.0,0.0]},{"text":".","bbox":[133.84,648.14557,136.89799,659.14557],"origin":[133.84,656.64502],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The EDA-8 yields a total score between 0 and 24, with higher scores indicating greater levels of","bbox":[91.0392,672.34558,555.69025,683.34558],"origin":[91.0392,680.84503],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"demand avoidance characteristics.","bbox":[91.0392,684.44556,260.38419,695.44556],"origin":[91.0392,692.94501],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Although no normative data or percentiles are available for the EDA-8, the following provides","bbox":[91.0392,708.64557,541.6322,719.64557],"origin":[91.0392,717.14502],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"context for interpreting scores. In the validation sample of autistic children and adolescents, the","bbox":[91.0392,720.74554,553.25909,731.74554],"origin":[91.0392,729.245],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"average score was 17.31 (SD = 6.41, Median = 19), indicating that EDA-8 scores are typically","bbox":[91.0392,732.84558,546.51636,743.84558],"origin":[91.0392,741.34503],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"higher in this group (O’Nions et al., 2021). In contrast, a sample of children without school","bbox":[91.0392,744.94556,526.34235,755.94556],"origin":[91.0392,753.44501],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"attendance difficulties associated with emotional distress had substantially lower scores,","bbox":[91.0392,757.04559,519.59912,768.04559],"origin":[91.0392,765.54504],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 2","bbox":[510.23621,809.92719,561.38629,819.92719],"origin":[510.23621,817.65399],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[],"chartObservations":[{"id":"chart_1","title":"EDA-8 Tota