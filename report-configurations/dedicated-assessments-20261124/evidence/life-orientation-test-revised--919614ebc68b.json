box":[361.254,640.77356,364.31201,651.77356],"origin":[361.254,649.27301],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The scale yields a total score ranging from 0-24. Higher scores indicate greater dispositional","bbox":[91.039,664.97357,539.15704,675.97357],"origin":[91.039,673.47302],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"optimism. Subscale scores range from 0-12 and are listed below:","bbox":[91.039,677.07355,407.10196,688.07355],"origin":[91.039,685.573],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Optimism (items 1, 4, and 10): Positive expectancies about future outcomes; reflecting the","bbox":[91.039,701.27356,528.784,712.27356],"origin":[91.039,709.77301],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"tendency to believe that good things will happen.","bbox":[91.039,713.37354,328.28693,724.37354],"origin":[91.039,721.87299],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Pessimism (items 3, 7, and 9): Negative expectancies about future outcomes; tendency to","bbox":[91.039,737.57355,528.17902,748.57355],"origin":[91.039,746.073],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"anticipate unfavourable results and focus on potential problems.","bbox":[91.039,749.67358,402.25098,760.67358],"origin":[91.039,758.17303],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 2","bbox":[510.23599,809.92712,561.38611,819.92712],"origin":[510.23599,817.65393],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[],"chartObservations":[{"id":"chart_1","title":"Optimism Percentile","type":"vertical_bar","bboxPt":[96.693,326.772,498.693,523.213],"widthPt":402.0,"heightPt":196.441,"axisColour":"#333333","xAxis":{"status":"unresolved","ticks":[{"value":0.0,"positionPt":89.1911,"text":"0","c