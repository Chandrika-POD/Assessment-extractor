,"lineWidthPt":1.0}],"curves":[]}}]},{"pageId":"df80aa2f6bc12_p2","documentSha256":"f80aa2f6bc12cb0e21b8134addca42ee2e5e27adc0c631cb6ae153b6a094568b","pageNumber":2,"text":[{"text":"Client Name","bbox":[66.3844,116.31287,135.73239,128.31287],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Generic Client","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The remaining four items serve as fillers to obscure the scale's purpose. The total score","bbox":[91.0395,155.26553,516.80554,166.26553],"origin":[91.0395,163.76501],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"provides a global index of optimistic orientation, while subscale scores offer information about","bbox":[91.0395,167.36551,545.28455,178.36551],"origin":[91.0395,175.86499],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"the presence of positive expectancies versus the absence of negative expectancies. Examining","bbox":[91.0395,179.46548,554.49164,190.46548],"origin":[91.0395,187.96497],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"subscale patterns can be clinically informative. For instance, individuals may show high","bbox":[91.0395,191.56546,514.69342,202.56546],"origin":[91.0395,200.06494],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"optimism with moderate pessimism, suggesting coexisting positive and negative future","bbox":[91.0395,203.66544,511.03049,214.66544],"origin":[91.0395,212.16492],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"expectancies.","bbox":[91.0395,215.76541,158.29349,226.76541],"origin":[91.0395,224.26489],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Percentile ranks based on population norms facilitate clinical interpretation. Using data from","bbox":[91.0395,239.96542,536.11047,250.96542],"origin":[91.0395,248.4649],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Hinz et al. (2017), a total score of 16 corresponds to the 50th percentile in the general","bbox":[91.0395,252.0654,507.42249,263.0654],"origin":[91.0395,260.56488],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"population. Scores below 13 (approximately 30th percentile) may indicate lower than typical","bbox":[91.0395,264.16537,536.11047,275.16537],"origin":[91.0395,272.66486],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"optimism warranting clinical attention, while scores above 19 (approximately 75th percentile)","bbox":[91.0395,276.26535,539.75153,287.26535],"origin":[91.0395,284.76483],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"suggest notably high optimism. However, extremely high scores may occasionally reflect","bbox":[91.0395,288.36533,521.40338,299.36533],"origin":[91.0395,296.86481],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"unrealistic optimism associated with risk-taking behaviours (Hmieleski & Baron, 2009).","bbox":[91.0395,300.4653,510.38141,311.4653],"origin":[91.0395,308.96478],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Responses","bbox":[34.3465,337.50427,151.8205,351.50427],"origin":[34.3465,348.32178],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Strongly","bbox":[272.1275,360.97241,303.30554,369.47241],"origin":[272.1275,367.54019],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Disagree","bbox":[270.71188,370.32242,304.72043,378.82242],"origin":[270.71188,376.8902],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Disagree","bbox":[330.23959,3