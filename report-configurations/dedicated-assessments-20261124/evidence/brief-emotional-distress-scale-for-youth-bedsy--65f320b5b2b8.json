lour":"#5dade2","sampleDrawingIndex":76,"sourceMarkBBoxPt":[250.34599,448.3985,368.34601,759.26849],"categoryPosition":0.4979161332893861,"barThicknessPt":118.00001999999998,"sampleValuePolicy":"evidence_only_never_runtime_input"}],"detection":{"method":"independent_axis_pair","reviewStatus":"machine_observed_not_visually_verified"},"sampleVisitCount":null,"variantEvidence":"single_visit_or_unspecified","drawingEvidence":{"axisDrawingIds":[78,80],"marks":[{"drawingIndex":76,"bboxPt":[250.34599,448.3985,368.34601,759.26849],"colour":"#5dade2","fill":"#5dade2","stroke":"#000000","lineWidthPt":1.0}],"curves":[]}}]},{"pageId":"d3c3da826ad1f_p2","documentSha256":"3c3da826ad1f9d1a061bf3be912f7d65d6468de193374df70b6995d0ab7e9108","pageNumber":2,"text":[{"text":"Client Name","bbox":[66.3844,116.31287,135.73239,128.31287],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Generic Client","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[34.3465,144.03752,290.26645,158.03752],"origin":[34.3465,154.85504],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"For comprehensive information on the BEDSY, ","bbox":[91.0394,163.29257,322.74341,174.29257],"origin":[91.0394,171.79205],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"see here","bbox":[322.74301,163.29355,365.54401,174.29355],"origin":[322.74301,171.79303],"font":"Helvetica","size":11.0,"colour":"#0000ff","direction":[1.0,0.0]},{"text":".","bbox":[365.54501,163.29355,368.60303,174.29355],"origin":[365.54501,171.79303],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"A total score is provided for the BEDSY (0 - 24) with higher scores indicating higher levels of","bbox":[91.04001,187.49356,539.77393,198.49356],"origin":[91.04001,195.99304],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"emotional distress. In addition, percentiles are computed based on community samples and are","bbox":[91.04001,199.59354,555.07507,210.59354],"origin":[91.04001,208.09302],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"dependent upon age brackets (11-17 for males, 11-13 or 14-17 for females) and gender","bbox":[91.04001,211.69351,517.81799,222.69351],"origin":[91.04001,220.19299],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"(Spence & Rapee, 2022).","bbox":[91.04001,223.79349,215.16397,234.79349],"origin":[91.04001,232.29297],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"A percentile of 50 indicates an average and healthy level of emotional distress when compared","bbox":[91.04001,247.9935,552.03912,258.9935],"origin":[91.04001,256.49298],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"to their age and gender-related peers. Note that females scored significantly higher on the","bbox":[91.04001,260.09348,528.20203,271.09348],"origin":[91.04001,268.59296],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"BEDSY than males (Spence & Rapee, 2022), so the same score for each gender will give","bbox":[91.04001,272.19345,526.95911,283.19345],"origin":[91.04001,280.69293],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"significantly different percentiles and, as a result, potentially different severity descriptors.","bbox":[91.04001,284.29343,524.49506,295.29343],"origin":[91.04001,292.79291],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scores are categorised into four severity ranges and are dependent upon the percentiles (S. H.","bbox":[91.04001,308.49344,553.27094,319.49344],"origin":[91.04001,316.99292],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Spence & R. M. Rapee, personal communication, May 1, 2024):","bbox":[91.04001,320.59341,402.22998,331.59341],"origin":[91.04001,329.0929],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Normal: Percentile of less than 84","bbox":[91.04001,332.69342,262.827,343.69342],"origin":[91.04001,341.1929],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Mild: Percentile of 84 or greater and less than 94","bbox":[91.04001,344.79343,334.98697,355.79343],"origin":[91.04001,353.29291],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Moderate: Percentile of 94 or greater and less than 98","bbox":[91.04001,356.89343,361.28799,367.89343],"origin":[91.04001,365.39291],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Severe: Percentile of 98 or greater","bbox":[91.04001,368.99344,265.89597,379.99344],"origin":[91.04001,377.49292],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"After the first administration, a plot is presented that shows the client's percentile score with the","bbox":[91.04001,393.19345,552.89709,404.19345],"origin":[91.04001,401.69293],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"severity ratings in the background.","bbox":[91.04001,405.29346,258.55896,416.29346],"origin":[91.04001,413.79294],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"After multiple administrations a longitudinal plot will be displayed for the BEDSY total score over","bbox":[91.04001,429.49347,556.89014,440.49347],"origin":[91.04001,437.99295],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"time.","bbox":[91.04001,441.59348,114.87701,452.59348],"origin":[91.04001,450.09296],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"t