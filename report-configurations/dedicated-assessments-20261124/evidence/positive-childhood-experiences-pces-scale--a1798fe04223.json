_only_not_a_scoring_threshold"}],"series":[{"label":"","colour":"#4285f4","sampleDrawingIndex":75,"sourceMarkBBoxPt":[280.34601,326.69696,338.34601,484.78702],"categoryPosition":0.49642860739795663,"barThicknessPt":58.0,"sampleValuePolicy":"evidence_only_never_runtime_input"}],"detection":{"method":"independent_axis_pair","reviewStatus":"machine_observed_not_visually_verified"},"sampleVisitCount":null,"variantEvidence":"single_visit_or_unspecified","drawingEvidence":{"axisDrawingIds":[77,79],"marks":[{"drawingIndex":75,"bboxPt":[280.34601,326.69696,338.34601,484.78702],"colour":"#4285f4","fill":"#4285f4","stroke":"#000000","lineWidthPt":1.0}],"curves":[]}}]},{"pageId":"d177b21b893d2_p2","documentSha256":"177b21b893d23b3a70a73ddfa2eb514e6a3321aba4a377c0f2a74d68cf6e50e7","pageNumber":2,"text":[{"text":"Client Name","bbox":[66.3844,116.31287,135.73239,128.31287],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Generic Client","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information (cont.)","bbox":[34.3465,144.03752,336.92838,158.03752],"origin":[34.3465,154.85504],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Low (0-2 PCEs): Indicates fewer protective childhood experiences than average. Research","bbox":[91.0394,163.29257,539.16846,174.29257],"origin":[91.0394,171.79205],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"suggests individuals in this range may benefit from building additional positive experiences and","bbox":[91.0394,175.39255,552.63239,186.39255],"origin":[91.0394,183.89203],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"supportive relationships in current life. Each new positive experience can contribute to improved","bbox":[91.0394,187.49252,556.90051,198.49252],"origin":[91.0394,195.992],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"resilience and wellbeing.","bbox":[91.0394,199.5925,210.86238,210.5925],"origin":[91.0394,208.09198],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Moderate (3-5 PCEs): Represents a moderate level of protective childhood experiences.","bbox":[91.0394,211.69247,526.93634,222.69247],"origin":[91.0394,220.19196],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Individuals in this range had access to some positive experiences that likely provide a","bbox":[91.0394,223.79245,506.77335,234.79245],"origin":[91.0394,232.29193],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"foundation for resilience. Building on these existing strengths may further enhance wellbeing","bbox":[91.0394,235.89243,539.80652,246.89243],"origin":[91.0394,244.39191],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"and coping capacity.","bbox":[91.0394,247.9924,191.31537,258.9924],"origin":[91.0394,256.49188],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- High (6-7 PCEs): Indicates a robust collection of protective childhood experiences. Research","bbox":[91.0394,260.09238,548.33148,271.09238],"origin":[91.0394,268.59186],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"shows that individuals with high PCEs demonstrate significant resilience and typically report","bbox":[91.0394,272.19235,536.70441,283.19235],"origin":[91.0394,280.69183],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"better mental health and social-emotional outcomes, even when faced with adversity.","bbox":[91.0394,284.29233,504.94739,295.29233],"origin":[91.0394,292.79181],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"These