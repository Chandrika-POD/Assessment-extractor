f96d9_p4","documentSha256":"252c638f96d93412caeb6b562ac161a3e685cd5e43cc55523d7c2033d0d9572d","pageNumber":4,"text":[{"text":"Client Name","bbox":[66.3844,116.31287,135.73239,128.31287],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Generic","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Responses (cont.)","bbox":[34.3465,144.03752,198.48251,158.03752],"origin":[34.3465,154.85504],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"6","bbox":[35.9047,168.35178,40.6307,176.85178],"origin":[35.9047,174.91956],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Things have been getting on top of me","bbox":[54.18905,168.35178,199.25006,176.85178],"origin":[54.18905,174.91956],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Yes, most of the time I haven't been able to cope at all","bbox":[51.1891,185.92526,269.69016,194.42526],"origin":[51.1891,192.49304],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Yes, sometimes I haven't been coping as well as usual","bbox":[51.18907,200.0817,285.17715,208.5817],"origin":[51.18907,206.64264],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    No, most of the time I have coped quite well","bbox":[51.18907,214.12918,230.25005,222.62918],"origin":[51.18907,220.69696],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    No, I have been coping as well as ever","bbox":[51.1891,228.15958,211.35457,236.65958],"origin":[51.1891,234.72736],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"7","bbox":[35.9047,245.733,40.6307,254.233],"origin":[35.9047,252.30078],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"I have been so unhappy that I have had difficulty sleeping","bbox":[51.18906,245.733,267.59909,254.233],"origin":[51.18906,252.30078],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Yes, most of the time","bbox":[51.1891,263.30649,145.2076,271.80649],"origin":[51.1891,269.87427],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Yes, sometimes","bbox":[51.18907,277.33737,125.82756,285.83737],"origin":[51.18907,283.90515],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Not very often","bbox":[51.18907,291.63638,122.51255,300.13638],"origin":[51.18907,298.19733],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    No, not at all","bbox":[51.1891,305.54129,113.08609,314.04129],"origin":[51.1891,312.10907],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"8","bbox":[35.9047,323.11472,40.6307,331.61472],"origin":[35.9047,329.6825],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"I have felt sad or miserable","bbox":[51.18906,323.11472,153.23154,331.61472],"origin":[51.18906,329.6825],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Yes, most of the time","bbox":[51.1891,340.6882,145.2076,349.1882],"origin":[51.1891,347.25598],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Yes, quite often","bbox":[51.18907,354.84464,128.65805,363.34464],"origin":[51.18907,361.40558],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Not very often","bbox":[51.18907,368.89209,118.27956,377.39209],"origin":[51.18907,375.45987],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    No, not at all","bbox":[51.1891,382.92291,113.08609,391.42291],"origin":[51.1891,389.49069],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"9","bbox":[35.9047,400.49631,40.6307,408.99631],"origin":[35.9047,407.06409],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"I have been so unhappy that I have been crying","bbox":[51.18906,400.49631,230.27557,408.99631],"origin":[51.18906,407.06409],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Yes, most of the time","bbox":[51.1891,418.06979,145.2076,426.56979],"origin":[51.1891,424.63757],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Yes, quite often","bbox":[51.18907,432.10028,124.43356,440.60028],"origin":[51.18907,438.66806],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Only occasionally","bbox":[51.18907,446.39932,137.65106,454.89932],"origin":[51.18907,452.96027],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    No, never","bbox":[51.1891,460.3042,102.21459,468.8042],"origin":[51.1891,466.87198],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"10","bbox":[33.5418,477.87759,42.9938,486.37759],"origin":[33.5418,484.44537],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"The thought of harming myself has occurred to me","bbox":[51.18907,477.87759,241.10458,486.37759],"origin":[51.18907,484.44537],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Yes, quite often","bbox":[51.18909,495.45108,124.43357,503.95108],"origin":[51.18909,502.01886],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Sometimes","bbox":[51.18906,509.48203,107.87556,517.98206],"origin":[51.18906,516.0498],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Hardly ever","bbox":[51.18906,523.65503,108.81905,532.15503],"origin":[51.18906,530.22278],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    Never","bbox":[51.18909,537.81189,88.98859,546.31189],"origin":[51.18909,544.3728],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Powered by TCPDF (www.tcpdf.org)","bbox":[2.99999,839.89209,19.16999,840.89209],"origin":[2.99999,840.66479],"font":"Helvetica","size":1.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 4 of 4","bbox":[510.23599,809.92706,561.38611,819.92706],"origin":[510.23599,817.65387],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[{"bbox":[33.5418,116.69302,285.17715,544.5683],"rows":[["","","Client Name","","","Client Generic"],["","","","","",""],["","","","","",""],["Client Responses (cont )\n.",null,null,null,null,null],["","","","","",""],["6","","Thingshavebeengettingontopofme",null,null,null],["","3 Yes mostofthetime\n,",null,null,null,"Ihaven'tbeenabletocopeatall"],["","2 Yes sometimesI\n,",null,"haven'tbeencopingaswellasusual",null,null],["","1 No mostofthetime\n,",null,null,"I","havecopedquitewell"],["","0 No Ihavebeencopingaswellasever\n,",null,null,null,null],["","","","","",""],["7","I","havebeensounhappythatIhavehaddifficultysleeping",null,null,null],["","3 Yes mostofthetime\n,",null,null,null,""],["","2 Yes sometimes\n,",null,"","",""],["","1 Notveryoften",null,"","",""],["","0 No notatall\n,",null,"","",""],["","","","","",""],["8","I","havefeltsadormiserable",null,null,null],["","","","","",""],["","3 Yes mostofthetime\n,",null,null,null,""],["","2 Yes quiteoften\n,",null,"","",""],["","1 Notveryoften",null,"","",""],["","0 No notatall\n,",null,"","",""],["","","","","",""],["9","I","havebeensounhappythatIhavebeencrying",null,null,null],["","3 Yes mostofthetime\n,",null,null,null,""],["","2 Yes quiteoften\n,",null,"","",""],["","1 Onlyoccasionally",null,null,"",""],["","0 No never\n,",null,"","",""],["","","","","",""],["10","Thethoughtofharmingmyselfhasoccurredtome",null,n