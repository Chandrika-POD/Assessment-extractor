{"assessmentId":"edinburgh-postnatal-depression-scale-epds--f7c9bf2e3dda","usage":"extraction_review_only_never_patient_report_input","pages":[{"pageId":"d252c638f96d9_p1","documentSha256":"252c638f96d93412caeb6b562ac161a3e685cd5e43cc55523d7c2033d0d9572d","pageNumber":1,"text":[{"text":"Edinburgh Postnatal Depression Scale (EPDS)","bbox":[143.211,116.7415,452.06494,130.7415],"origin":[143.211,127.55902],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Name","bbox":[69.7204,135.98767,135.73239,147.98767],"origin":[69.7204,145.25983],"font":"Helvetica-Oblique","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Generic","bbox":[147.7325,136.54977,217.41748,147.54977],"origin":[147.7325,145.04926],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Date administered","bbox":[364.34851,136.13025,461.71649,148.13025],"origin":[364.34851,145.4024],"font":"Helvetica-Oblique","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"23 Oct 2026","bbox":[473.71649,136.54977,533.64465,147.54977],"origin":[473.71649,145.04926],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Date of birth (age)","bbox":[39.02451,151.57831,135.7325,163.57831],"origin":[39.02451,160.85046],"font":"Helvetica-Oblique","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"1 Jan 1990 (36)","bbox":[147.73251,151.99783,224.77647,162.99783],"origin":[147.73251,160.49731],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Time taken","bbox":[402.3645,151.57831,461.71649,163.57831],"origin":[402.3645,160.85046],"font":"Helvetica-Oblique","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"37s","bbox":[473.71649,151.99783,491.44849,162.99783],"origin":[473.71649,160.49731],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Assessor","bbox":[86.38849,167.02637,135.73248,179.02637],"origin":[86.38849,176.29852],"font":"Helvetica-Oblique","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Dr Emerson Bartholomew","bbox":[147.73259,167.44589,273.64954,178.44589],"origin":[147.73259,175.94537],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"EPDS Results","bbox":[34.3465,197.89549,126.92852,211.89549],"origin":[34.3465,208.71301],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Score","bbox":[325.79111,218.75375,354.5231,229.75375],"origin":[325.79111,227.25323],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Descriptor","bbox":[456.83136,218.75375,506.94733,229.75375],"origin":[456.83136,227.25323],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Total Score (0-30)","bbox":[139.9328,234.20187,228.57076,245.20187],"origin":[139.9328,242.70135],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"14","bbox":[334.04138,234.20187,346.27338,245.20187],"origin":[334.04138,242.70135],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"High","bbox":[470.58109,234.20187,493.19705,245.20187],"origin":[470.58109,242.70135],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Elevated","bbox":[456.73901,477.92825,483.97601,484.92825],"origin":[456.73901,483.33701],"font":"Helvetica","size":7.0,"colour":"#424242","direction":[1.0,0.0]},{"text":"High","bbox":[469.58499,390.45825,483.97696,397.45825],"origin":[469.58499,395.867],"font":"Helvetica","size":7.0,"colour":"#c62828","direction":[1.0,0.0]},{"text":"0","bbox":[95.4164,570.56018,100.97639,580.56018],"origin":[95.4164,578.28699],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"5","bbox":[95.4164,527.89032,100.97639,537.89032],"origin":[95.4164,535.61713],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"10","bbox":[89.85663,485.23053,100.97662,495.23053],"origin":[89.85663,492.95734],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"13","bbox":[89.85663,459.63013,100.97662,469.63013],"origin":[89.85663,467.35693],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"15","bbox":[89.85663,442.56024,100.97662,452.56024],"origin":[89.85663,450.28705],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"20","bbox":[89.85663,399.89035,100.97662,409.89035],"origin":[89.85663,407.61716],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"25","bbox":[89.85663,357.23056,100.97662,367.23056],"origin":[89.85663,364.95737],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"30","bbox":[89.85663,314.56024,100.97662,324.56024],"origin":[89.85663,322.28705],"font":"Helvetica","size":10.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"Edinburgh Postnatal Depression Scale (EPDS) Total Score","bbox":[130.76601,296.87488,464.18594,308.87488],"origin":[130.76601,306.14703],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Interpretive Text","bbox":[34.3465,613.09253,143.26651,627.09253],"origin":[34.3465,623.91003],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The Edinburgh Postnatal Depression Scale (EPDS) was administered on 23 October 2026, with","bbox":[91.0394,632.34808,556.29547,643.34808],"origin":[91.0394,640.84753],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"a total score of 14 out of 30. This score falls in the High range, which suggests probable","bbox":[91.0394,644.44806,517.80634,655.44806],"origin":[91.0394,652.94751],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"depressive illness. Most women without major depression (95%) score below 13 (Levis et al.,","bbox":[91.0394,656.5481,543.41431,667.5481],"origin":[91.0394,665.04755],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"2020), so a score in this range is likely to reflect a depressive illness and warrants further mental","bbox":[91.0394,668.64807,559.33148,679.64807],"origin":[91.0394,677.14752],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"health assessment.","bbox":[91.0394,680.74811,185.80437,691.74811],"origin":[91.0394,689.24756],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The highest-scoring items were:","bbox":[91.0394,704.94806,246.92035,715.94806],"origin":[91.0394,713.44751],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 1. I have been able to laugh and see the funny side of things (Definitely not so much now)","bbox":[91.0394,717.0481,533.72351,728.0481],"origin":[91.0394,725.54755],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 2. I have looked forward with enjoyment to things (Definitely less than I used to)","bbox":[91.0394,729.14807,484.15744,740.14807],"origin":[91.0394,737.64752],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 3. I have blamed myself unnecessarily when things went wrong (Yes, some of the time)","bbox":[91.0394,741.24811,522.04144,752.24811],"origin":[91.0394,749.74756],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Note. The three highest-scoring items are listed, with ties broken by item number.","bbox":[91.0394,753.34808,486.57739,764.34808],"origin":[91.0394,761.84753],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 4","bbox":[510.23639,809.92694,561.38647,819.92694],"origin":[510.23639,817.65375],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[],"chartObservations":[{"id":"chart_1","title":"Edinburgh Postnatal Depression Scale (EPDS) Total Score","type":"line","bboxPt":[105.977,316.787,490.977,574.787],"widthPt":385.0,"heightPt":258.0,"axisColour":"#333333","xAxis":{"status":"unresolved","ticks":[{"value":0.0,"positionPt":98.196395,"text":"0","colour":"#333333"}],"title":null},"yAxis":{"status":"linear_ticks_observed","ticks":[{"value":30.0,"positionPt":319.56024,"text":"30","colour":"#333333"},{"value":25.0,"positionPt":362.23056,"text":"25","colour":"#333333"},{"value":20.0,"positionPt":404.89035,"text":"20","colour":"#333333"},{"value":15.0,"positionPt":447.56024,"text":"15","colour":"#333333"},{"value":13.0,"positionPt":464.63013,"text":"13","colour":"#333333"},{"value":10.0,"positionPt":490.23053,"text":"10","colour":"#333333"},{"value":5.0,"positionPt":532.89032,"text":"5","colour":"#333333"},{"value":0.0,"positionPt":575.56018,"text":"0","colour":"#333333"}],"title":null,"minimum":0.0,"maximum":30.0,"coordinateFit":{"slope":-0.11718809092032977,"offset":67.44878941500802,"maximumResidual":0.0004622664438755919}},"observedDataType":"raw_score","labels":[{"text":"Elevated","bboxPt":[456.73901,477.92825,483.97601,484.92825],"colour":"#424242","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"High","bboxPt":[469.58499,390.45825,483.97696,397.45825],"colour":"#c62828","font":"Helvetica","fontSizePt":7.0,"direction":[1.0,0.0]},{"text":"Edinburgh Postnatal Depression Scale (EPDS) Total Score","bboxPt":[130.76601,296.87488,464.18594,308.87488],"colour":"#000000","font":"Helvetica-Bold","fontSizePt":12.0,"direction":[1.0,0.0]},{"text":"Interpretive Text","bboxPt":[34.3465,613.09253,143.26651,627.09253],"colour":"#000000","font":"Helvetica-Bold","fontSizePt":14.0,"direction":[1.0,0.0]},{"text":"The Edinburgh Postnatal Depression Scale (EPDS) was administered on 23 October 2026, with","bboxPt":[91.0394,632.34808,556.29547,643.34808],"colour":"#000000","font":"Helvetica","fontSizePt":11.0,"direction":[1.0,0.0]}],"backgroundBands":[{"bboxPt":[105.97701,493.7171,488.97702,574.78699],"colour":"#ffffff","opacity":1.0,"semantics":"visual_background_only_not_a_scoring_threshold"},{"bboxPt":[105.97701,468.117,488.97702,493.71701],"colour":"#d5d5d5","opacity":1.0,"semantics":"visual_background_only_not_a_scoring_threshold"},{"bboxPt":[105.97701,318.78699,488.97702,468.117],"colour":"#f3bcbd","opacity":1.0,"semantics":"visual_background_only_not_a_scoring_threshold"}],"series":[],"detection":{"method":"independent_axis_pair","reviewStatus":"machine_observed_not_visually_verified"},"sampleVisitCount":1,"variantEvidence":"repeat_administration","drawingEvidence":{"axisDrawingIds":[61,63],"marks":[{"drawingIndex":59,"bboxPt":[269.47702,455.31702,325.47702,574.78699],"colour":"#007da5","fill":"#007da5","stroke":"#000000","lineWidthPt":1.0}],"curves":[]}}]},{"pageId":"d252c638f96d9_p2","documentSha256":"252c638f96d93412caeb6b562ac161a3e685cd5e43cc55523d7c2033d0d9572d","pageNumber":2,"text":[{"text":"Client Name","bbox":[66.3844,116.31287,135.73239,128.31287],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Generic","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[34.3465,162.34251,290.26645,176.34251],"origin":[34.3465,173.16003],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"For comprehensive information on the EPDS, ","bbox":[91.0394,181.59854,315.4064,192.59854],"origin":[91.0394,190.09802],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"see here","bbox":[315.40601,181.5975,358.207,192.5975],"origin":[315.40601,190.09698],"font":"Helvetica","size":11.0,"colour":"#0000ff","direction":[1.0,0.0]},{"text":".","bbox":[358.207,181.5975,361.26501,192.5975],"origin":[358.207,190.09698],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The total score is calculated by summing all 10 items, giving a range of 0 to 30. Higher scores","bbox":[91.039,205.79752,546.50507,216.79752],"origin":[91.039,214.297],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"indicate more frequent or more intense depressive symptoms over the previous seven days.","bbox":[91.039,217.89749,538.55194,228.89749],"origin":[91.039,226.39697],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"EPDS Severity Categories","bbox":[91.039,242.0975,220.02496,253.0975],"origin":[91.039,250.59698],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Two descriptor bands are applied to the total score, at the scale authors' own cut-offs of 10 and","bbox":[91.039,266.29752,553.54523,277.29752],"origin":[91.039,274.797],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"13. Each does a different job: 10 is set low to catch as many cases as possible, and 13 is set","bbox":[91.039,278.39749,542.27002,289.39749],"origin":[91.039,286.89697],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"high to flag the women most likely to have depression. Scores of 9 or below fall beneath both","bbox":[91.039,290.49747,542.87506,301.49747],"origin":[91.039,298.99695],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"and carry no descriptor. The report gives the number without a label, and clinical judgement","bbox":[91.039,302.59744,536.12097,313.59744],"origin":[91.039,311.09692],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"guides follow-up.","bbox":[91.039,314.69742,173.57198,325.69742],"origin":[91.039,323.1969],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Elevated (10 to 12): a more sensitive screen, in other words a wider net that catches more cases","bbox":[91.039,338.89743,560.57416,349.89743],"origin":[91.039,347.39691],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"but includes more non-cases. Scores of 10 or more identify 85% of women with major","bbox":[91.039,350.99744,507.36697,361.99744],"origin":[91.039,359.49692],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"depression (Levis et al., 2020). A score in this range may reflect a depressive illness and","bbox":[91.039,363.09744,522.052,374.09744],"origin":[91.039,371.59692],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"warrants further enquiry now, with the EPDS repeated within two to four weeks (COPE, 2023).","bbox":[91.039,375.19745,548.94714,386.19745],"origin":[91.039,383.69693],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"High (13 to 30): probable depressive illness. Most women without major depression (95%) score","bbox":[91.039,399.39746,558.70398,410.39746],"origin":[91.039,407.89694],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"below 13, so scores in this range are seldom seen without it. The trade-off is that about a third of","bbox":[91.039,411.49747,559.99115,422.49747],"origin":[91.039,419.99695],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"women with major depression also score below 13, which is why the Elevated range sits","bbox":[91.039,423.59747,519.58795,434.59747],"origin":[91.039,432.09695],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"beneath it (Levis et al., 2020). A score in this range is likely to reflect a depressive illness and","bbox":[91.039,435.69748,543.45795,446.69748],"origin":[91.039,444.19696],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"warrants further mental health assessment.","bbox":[91.039,447.79749,301.95294,458.79749],"origin":[91.039,456.29697],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"How likely a High score is to reflect depression depends on how common depression is in the","bbox":[91.039,471.9975,545.27301,482.9975],"origin":[91.039,480.49698],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"population being screened, so the score identifies who needs a closer look rather than","bbox":[91.039,484.0975,509.86395,495.0975],"origin":[91.039,492.59698],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"confirming a diagnosis. Responses may also shift when the questionnaire is completed in front","bbox":[91.039,496.19751,550.17908,507.19751],"origin":[91.039,504.69699],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"of family members, or where disclosure feels risky.","bbox":[91.039,508.29752,337.37296,519.29755],"origin":[91.039,516.797],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"EPDS Item 10 and Risk of Self-Harm","bbox":[91.039,532.49756,271.37296,543.49756],"origin":[91.039,540.99701],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Item 10 asks directly about thoughts of self-harm. Any endorsement generates a risk alert in the","bbox":[91.039,556.69757,556.30615,567.69757],"origin":[91.039,565.19702],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"report, whatever the total score, and Australian guidance recommends immediate further mental","bbox":[91.039,568.79755,558.12109,579.79755],"origin":[91.039,577.297],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"health assessment (COPE, 2023). The item does not ask specifically about suicidal ideation, so","bbox":[91.039,580.89758,555.07404,591.89758],"origin":[91.039,589.39703],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"responses should be explored further and read both on their own and alongside the total score.","bbox":[91.039,592.99762,553.29205,603.99762],"origin":[91.039,601.49707],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The thresholds work the same with or without item 10: total scores with and without it correlate","bbox":[91.039,617.19757,549.55225,628.19757],"origin":[91.039,625.69702],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"at .998 (Qiu et al., 2023). A respondent may score in the Elevated or High range while","bbox":[91.039,629.29761,508.63193,640.29761],"origin":[91.039,637.79706],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"answering Never to item 10, or may endorse item 10 while the total score stays below 10. The","bbox":[91.039,641.39758,547.72607,652.39758],"origin":[91.039,649.89703],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"second pattern does not on its own indicate depression, but it does indicate a risk of self-harm","bbox":[91.039,653.49762,547.75916,664.49762],"origin":[91.039,661.99707],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"that warrants attention in its own right.","bbox":[91.039,665.5976,276.28995,676.5976],"origin":[91.039,674.09705],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"EPDS Change Score Interpretation","bbox":[91.039,689.79761,262.23193,700.79761],"origin":[91.039,698.29706],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Where EPDS scores are available from more than one administration, change between","bbox":[91.039,713.99762,514.71503,724.99762],"origin":[91.039,722.49707],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"administrations supports progress monitoring. A change of 4 or more points is treated as a","bbox":[91.039,726.0976,530.00507,737.0976],"origin":[91.039,734.59705],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"reliable change, meaning a change large enough to be unlikely to reflect measurement error","bbox":[91.039,738.19757,538.58508,749.19757],"origin":[91.039,746.69702],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"alone (Matthey, 2004).","bbox":[91.039,750.29761,201.09396,761.29761],"origin":[91.039,758.79706],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 2 of 4","bbox":[510.23599,809.92725,561.38611,819.92725],"origin":[510.23599,817.65405],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[],"chartObservations":[]},{"pageId":"d252c638f96d9_p3","documentSha256":"252c638f96d93412caeb6b562ac161a3e685cd5e43cc55523d7c2033d0d9572d","pageNumber":3,"text":[{"text":"Client Name","bbox":[66.3844,116.31287,135.73239,128.31287],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Generic","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"EPDS Graphs","bbox":[91.0395,155.26553,160.11948,166.26553],"origin":[91.0395,163.76501],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"On a first administration, a single vertical bar chart displays the total score against the full 0 to","bbox":[91.0395,179.46555,545.90057,190.46555],"origin":[91.0395,187.96503],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"30 range. Where two or more administrations are available, a line graph shows the total score","bbox":[91.0395,191.56552,546.50549,202.56552],"origin":[91.0395,200.065],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"across administration dates instead, covering up to the 60 most recent administrations and split","bbox":[91.0395,203.6655,553.85364,214.6655],"origin":[91.0395,212.16498],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"into two graphs, oldest first, where there are more than 30. Shading on both charts is a visual","bbox":[91.0395,215.76547,543.48065,226.76547],"origin":[91.0395,224.26495],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"guide to the descriptor bands: unshaded below 10, grey from 10 to 12 (Elevated), and a red tint","bbox":[91.0395,227.86545,553.2926,238.86545],"origin":[91.0395,236.36493],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"from 13 to 30 (High), with 13 marked on the vertical axis.","bbox":[91.0395,239.96542,366.75446,250.96542],"origin":[91.0395,248.4649],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Responses","bbox":[34.3465,301.58649,151.8205,315.58649],"origin":[34.3465,312.40399],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"1","bbox":[35.9047,325.90073,40.6307,334.40073],"origin":[35.9047,332.46851],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"I have been able to laugh and see the funny side of things","bbox":[54.18905,325.90073,272.02707,334.40073],"origin":[54.18905,332.46851],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    As much as I always could","bbox":[51.18909,343.47382,165.51407,351.97382],"origin":[51.18909,350.0416],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Not quite so much now","bbox":[51.18906,357.50473,151.82054,366.00473],"origin":[51.18906,364.07251],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Definitely not so much now","bbox":[51.18906,371.80377,175.88405,380.30377],"origin":[51.18906,378.36472],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Not at all","bbox":[51.18909,385.70865,98.90809,394.20865],"origin":[51.18909,392.27643],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2","bbox":[35.90469,403.28204,40.6307,411.78204],"origin":[35.90469,409.84982],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"I have looked forward with enjoyment to things","bbox":[51.18906,403.28204,225.99155,411.78204],"origin":[51.18906,409.84982],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    As much as I ever did","bbox":[51.18909,420.85553,147.09459,429.35553],"origin":[51.18909,427.42331],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Rather less than I used to","bbox":[51.18906,434.88644,162.22456,443.38644],"origin":[51.18906,441.45422],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Definitely less than I used to","bbox":[51.18906,449.18549,180.15105,457.68549],"origin":[51.18906,455.74643],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Hardly at all","bbox":[51.18909,463.09036,110.23859,471.59036],"origin":[51.18909,469.65814],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3","bbox":[35.90469,480.66376,40.6307,489.16376],"origin":[35.90469,487.23154],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"I have blamed myself unnecessarily when things went wrong","bbox":[51.18906,480.66376,279.36307,489.16376],"origin":[51.18906,487.23154],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Yes, most of the time","bbox":[51.18909,498.23724,145.20758,506.73724],"origin":[51.18909,504.80502],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Yes, some of the time","bbox":[51.18906,512.39368,152.75557,520.89368],"origin":[5