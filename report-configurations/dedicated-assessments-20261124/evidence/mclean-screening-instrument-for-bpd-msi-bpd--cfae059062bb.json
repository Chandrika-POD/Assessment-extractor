ur":"#000000","font":"Helvetica","fontSizePt":6.0,"direction":[1.0,0.0]}],"backgroundBands":[{"bboxPt":[124.189,427.81702,478.18903,554.78699],"colour":"#ffffff","opacity":0.8,"semantics":"visual_background_only_not_a_scoring_threshold"},{"bboxPt":[124.189,379.2272,478.18903,427.56702],"colour":"#d3d3d3","opacity":0.5,"semantics":"visual_background_only_not_a_scoring_threshold"},{"bboxPt":[124.189,300.34692,478.18903,379.22702],"colour":"#ea9999","opacity":0.5,"semantics":"visual_background_only_not_a_scoring_threshold"}],"series":[{"label":"","colour":"#4caf50","sampleDrawingIndex":75,"sourceMarkBBoxPt":[281.189,529.34717,321.189,554.78699],"categoryPosition":0.4971909693378397,"barThicknessPt":40.0,"sampleValuePolicy":"evidence_only_never_runtime_input"}],"detection":{"method":"independent_axis_pair","reviewStatus":"machine_observed_not_visually_verified"},"sampleVisitCount":null,"variantEvidence":"single_visit_or_unspecified","drawingEvidence":{"axisDrawingIds":[77,79],"marks":[{"drawingIndex":75,"bboxPt":[281.189,529.34717,321.189,554.78699],"colour":"#4caf50","fill":"#4caf50","stroke":"#000000","lineWidthPt":1.0}],"curves":[]}}]},{"pageId":"df2c63560c1c9_p2","documentSha256":"f2c63560c1c9511d45ba941348b819c42b8bf09051600b3005ae446fc184bf39","pageNumber":2,"text":[{"text":"Client Name","bbox":[66.3844,116.31287,135.73239,128.31287],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Generic Client","bbox":[147.73239,116.56485,217.41737,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[34.3465,144.03752,290.26645,158.03752],"origin":[34.3465,154.85504],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"MSI-BPD Total Score","bbox":[91.0394,163.29355,196.17738,174.29355],"origin":[91.0394,171.79303],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Each item is rated on a dichotomous scale with 1 corresponding to “present” and 0","bbox":[91.0394,187.49356,492.11035,198.49356],"origin":[91.0394,195.99304],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"corresponding to “absent”. The total score ranges from 0 to 10.","bbox":[91.0394,199.59354,396.74039,210.59354],"origin":[91.0394,208.09302],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"MSI-BPD Clinical Cut-off","bbox":[91.0394,223.79355,211.44539,234.79355],"origin":[91.0394,232.29303],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"A score of 7 or greater is above the traditional cutoff for BPD screening (Zanarini et al., 2003). A","bbox":[91.0394,247.99356,556.92242,258.99356],"origin":[91.0394,256.49304],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"score of 5 or 6 suggests BPD cannot be ruled out and further evaluation is recommended, as","bbox":[91.0394,260.09354,542.87549,271.09354],"origin":[91.0394,268.59302],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"research indicates 19% of individuals with BPD score below 7 (Zanarini et al., 2003; Zimmerman","bbox":[91.0394,272.19351,559.9256,283.19351],"origin":[91.0394,280.69299],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"& Balling, 2021). Scores of 4 or less indicate that symptom levels are not consistent with BPD.","bbox":[91.0394,284.29349,548.34235,295.29349],"origin":[91.0394,292.79297],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"MSI-BPD Percentiles","bbox":[91.0394,308.4935,194.34039,319.4935],"origin":[91.0394,316.99298],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"A percentile is presented that compares the respondent’s score to a university sample of 235","bbox":[91.0394,332.69351,542.24841,343.69351],"origin":[91.0394,341.19299],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"US students (55% female; mean age 18.5 years; Klonsky & Glenn, 2009). This non-clinical","bbox":[91.0394,344.79352,531.84247,355.79352],"origin":[91.0394,353.293],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"comparison group had a mean score of 4.83 (SD = 2.64). A percentile rank close to 50 indicates","bbox":[91.0394,356.89352,557.84662,367.89352],"origin":[91.0394,365.39301],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"the score is typical for this comparison sample. Percentile labels are displayed on the right side","bbox":[91.0394,368.99353,552.61041,379.99353],"origin":[91.0394,377.49301],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"of the graph for reference.","bbox":[91.0394,381.09354,218.22133,392.09354],"origin":[91.0394,389.59302],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"MSI-BPD Plots","bbox":[91.0394,405.29355,164.38741,416.29355],"origin":[91.0394,413.79303],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"On first administration, a bar graph displaying the total score is presented. When the","bbox":[91.0394,429.49356,500.6684,440.49356],"origin":[91.0394,437.99304],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"assessment is administered multiple times, a longitudinal line graph is generated to track","bbox":[91.0394,441.59357,522.04138,452.59357],"origin":[91.0394,450.09305],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"changes in the total score over time.","bbox":[91.0394,453.69357,267.73236,464.69357],"origin":[91.0394,462.19305],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Each endorsed item on the MSI-BPD corresponds to a specific DSM-5 criterion and provides","bbox":[91.0394,477.89359,541.59943,488.89359],"origin":[91.0394,486.39307],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"clinically meaningful information for treatment planning. Clinicians are encouraged to review","bbox":[91.0394,489.99359,536.70441,500.99359],"origin":[91.0394,498.49307],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"which items were endorsed to identify specific symptom areas that may be most relevant for","bbox":[91.0394,502.0936,537.92548,513.09363],"origin":[91.0394,510.59308],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"intervention. The pattern of endorsed items can help guide therapeutic focus and inform case","bbox":[91.0394,514.19366,543.49139,525.19366],"origin":[91.0394,522.69312],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"conceptualisation.","bbox":[91.0394,526.29364,179.08337,537.29364],"origin":[91.0394,534.79309],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Responses","bbox":[34.3464,576.26428,151.8204,590.26428],"origin":[34.3464,587.08179],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Yes","bbox":[325.04016,604.40698,339.68567,612.90704],"origin":[325.04016,610.97479],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"No","bbox":[475.75027,604.40698,486.61328,612.90704],"origin":[475.75027,610.97479],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1","bbox":[37.32178,632.75354,42.04779,641.25354],"origin":[37.32178,639.32129],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Have any of your closest relationships been troubled","bbox":[57.02338,628.07849,254.50385,636.57855],"origin":[57.02338,634.6463],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text"