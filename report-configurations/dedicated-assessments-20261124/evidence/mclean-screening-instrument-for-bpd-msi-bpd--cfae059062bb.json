This response pattern is not","bbox":[91.0394,653.50409,535.17542,664.50409],"origin":[91.0394,662.00354],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"consistent with borderline personality presentations and suggests the client does not currently","bbox":[91.0394,665.60406,546.52753,676.60406],"origin":[91.0394,674.10352],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"endorse symptoms characteristic of BPD.","bbox":[91.0394,677.7041,292.7684,688.7041],"origin":[91.0394,686.20355],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The client endorsed 1 out of 10 items, which falls at the 7th percentile compared to a non-clinical","bbox":[91.0394,701.90411,559.98059,712.90411],"origin":[91.0394,710.40356],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"sample; they endorsed symptoms corresponding to 1 of the 9 DSM-5 criteria for BPD. Endorsed","bbox":[91.0394,714.00409,557.50562,725.00409],"origin":[91.0394,722.50354],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"criteria include: troubled relationships (","bbox":[91.0394,726.10406,279.32635,737.10406],"origin":[91.0394,734.60352],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Item 1, Criterion 2: unstable interpersonal relationships","bbox":[279.32642,726.10406,545.87854,737.10406],"origin":[279.32642,734.60352],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":").","bbox":[545.87842,726.10406,552.59943,737.10406],"origin":[545.87842,734.60352],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 3","bbox":[510.23621,809.92749,561.38629,819.92749],"origin":[510.23621,817.6543],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[{"bbox":[28.3465,113.38562,566.92939,180.0],"rows":[["McLean Screening Instrum