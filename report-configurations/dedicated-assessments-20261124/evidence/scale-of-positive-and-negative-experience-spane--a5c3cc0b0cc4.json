446,322.07202],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"SPANE-N","bbox":[227.83597,325.83752,276.73096,340.95154],"origin":[227.83597,337.66254],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"17","bbox":[368.05722,325.83752,380.28922,340.95154],"origin":[368.05722,337.66254],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"73","bbox":[470.10446,325.83752,482.33646,340.95154],"origin":[470.10446,337.66254],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"SPANE-B","bbox":[228.13846,341.42807,276.42847,356.54208],"origin":[228.13846,353.25308],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"2","bbox":[371.11523,341.42807,377.23123,356.54208],"origin":[371.11523,353.25308],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"25","bbox":[470.10446,341.42807,482.33646,356.54208],"origin":[470.10446,353.25308],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Interpretive Text","bbox":[74.03149,369.4816,182.95149,388.75961],"origin":[74.03149,384.46161],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"None available","bbox":[187.41733,391.03439,260.17133,406.14841],"origin":[187.41733,402.85941],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[74.03149,419.08789,329.95145,438.36591],"origin":[74.03149,434.0679],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The Scale of Positive and Negative Experience gives three scores:","bbox":[187.41733,439.18039,512.0603,454.2944],"origin":[187.41733,451.0054],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"the overall affect balance score (SPANE-B) and the positive and","bbox":[187.41733,451.2804,499.83936,466.39441],"origin":[187.41733,463.10541],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"negative feelings scales; the SPANE-P and SPANE-N. The latter","bbox":[187.41733,463.3804,502.88641,478.49442],"origin":[187.41733,475.20541],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"two scale scores can vary from 6 to 30, where higher numbers","bbox":[187.41733,475.48041,490.64337,490.59442],"origin":[187.41733,487.30542],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"represent higher positive or negative emotions. These scores","bbox":[187.41733,487.58041,485.15433,502.69443],"origin":[187.41733,499.40543],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"indicate the individual's tendency to feel and identify emotions in","bbox":[187.41733,499.68039,499.50934,514.79437],"origin":[187.41733,511.5054],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"themselves. Extroverts are more likely to score higher on both these","bbox":[187.41733,511.7804,518.77039,526.89441],"origin":[187.41733,523.60541],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"subscales compared with introverts.  The affect balance (SPANE-B)","bbox":[187.41733,523.88043,517.53839,538.99445],"origin":[187.41733,535.70544],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"subscale is a measure of the balance between positive and negative","bbox":[187.41733,535.98041,520.03534,551.09442],"origin":[187.41733,547.80542],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"emotions, and the resultant score can vary from -24 (unhappiest) to","bbox":[187.41733,548.08038,515.11841,563.1944],"origin":[187.41733,559.9054],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"24 (happiest). A respondent with a very high score of 24 reports that","bbox":[187.41733,560.18036,518.80341,575.29437],"origin":[187.41733,572.00537],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"she or he rarely or never experiences any of the negative feelings,","bbox":[187.41733,572.2804,509.62933,587.39441],"origin":[187.41733,584.10541],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"and very often or always has all of the positive feelings.  ","bbox":[187.41733,584.38043,462.54935,599.49445],"origin":[187.41733,596.20544],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The mean and standard deviation (as derived by Diener et al (2009)","bbox":[187.41733,608.58038,517.57135,623.6944],"origin":[187.41733,620.4054],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"with 689 college students) for each scale is as follows: ","bbox":[187.41733,620.68042,454.58539,635.79443],"origin":[187.41733,632.50543],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-  SPANE-P = 22.02 (SD=3.73),","bbox":[187.41733,644.88043,342.09937,659.99445],"origin":[187.41733,656.70544],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-  SPANE-N = 15.36 (SD = 3.95), and ","bbox":[187.41733,656.98041,373.28442,672.09442],"origin":[187.41733,668.80542],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-  SPANE-B = 6.69 (SD=6.88). ","bbox":[187.41733,669.08038,339.04138,684.1944],"origin":[187.41733,680.9054],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Raw scores and percentiles are presented for each subscale.","bbox":[187.41733,693.2804,485.77032,708.39441],"origin":[187.41733,705.10541],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 2","bbox":[467.71652,784.13007,523.98157,799.24408],"origin":[467.71652,795.95508],"font":"Helvetica","size"