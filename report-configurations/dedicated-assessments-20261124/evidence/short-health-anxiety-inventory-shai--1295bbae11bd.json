4.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"1","bbox":[75.58975,224.56789,80.31575,236.24689],"origin":[75.58975,233.70538],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"I worry about my health","bbox":[93.87402,224.56789,182.21452,236.24689],"origin":[93.87402,233.70538],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    Never","bbox":[90.87402,242.14125,127.7215,253.82025],"origin":[90.87402,251.27875],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Occasionally","bbox":[90.87402,256.172,153.22998,267.85101],"origin":[90.87402,265.30951],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Much of the time","bbox":[90.87402,270.48123,172.58453,282.22824],"origin":[90.87402,279.60175],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Most of the time","bbox":[90.87402,284.37592,165.52103,296.05493],"origin":[90.87402,293.51343],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2","bbox":[75.58975,301.94934,80.31575,313.62836],"origin":[75.58975,311.08685],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Compared to other people my age I noticed aches and pains","bbox":[90.87402,301.94934,318.60617,313.62836],"origin":[90.87402,311.08685],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    less than most other people","bbox":[90.87402,319.52277,209.46602,331.20178],"origin":[90.87402,328.66028],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    as much as most other people","bbox":[90.87402,333.55347,218.90953,345.23248],"origin":[90.87402,342.69098],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    more than most other people","bbox":[90.87402,347.8627,222.18202,359.60971],"origin":[90.87402,356.98322],"