151,325.36102],"origin":[329.78952,322.07202],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"99.9","bbox":[388.98203,310.24701,410.38803,325.36102],"origin":[388.98203,322.07202],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"44.7","bbox":[474.02142,310.24701,495.42743,325.36102],"origin":[474.02142,322.07202],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Health Anxiety (0-42)","bbox":[196.3755,325.83752,299.6875,340.95154],"origin":[196.3755,337.66254],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"29","bbox":[329.78952,325.83752,342.02151,340.95154],"origin":[329.78952,337.66254],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-","bbox":[397.85355,325.83752,401.51654,340.95154],"origin":[397.85355,337.66254],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-","bbox":[482.89291,325.83752,486.55591,340.95154],"origin":[482.89291,337.66254],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Negative Consequences (0-12)","bbox":[187.41733,343.04544,308.64575,355.08154],"origin":[187.41733,352.46234],"font":"Helvetica","size":8.759905815124512,"colour":"#000000","direction":[1.0,0.0]},{"text":"8","bbox":[332.8475,341.42807,338.9635,356.54208],"origin":[332.8475,353.25308],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-","bbox":[397.85355,341.42807,401.51654,356.54208],"origin":[397.85355,353.25308],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"-","bbox":[482.89291,341.42807,486.55591,356.54208],"origin":[482.89291,353.25308],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[74.03149,369.4816,329.95145,388.75961],"origin":[74.03149,384.46161],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scores consist of a total (range = 0 to 54) and scores for two","bbox":[187.41733,389.5741,481.81049,404.68811],"origin":[187.41733,401.39911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"subscales:","bbox":[187.41733,401.6741,239.38132,416.78812],"origin":[187.41733,413.49911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Health Anxiety (items 1-14, range 0 to 42) which measures anxiety","bbox":[187.41733,425.87411,518.15436,440.98813],"origin":[187.41733,437.69913],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"related to health","bbox":[187.41733,437.97409,266.29831,453.0881],"origin":[187.41733,449.7991],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- Negative Consequences’ of becoming ill (items 15-18, range 0 to","bbox":[187.41733,462.1741,509.6073,477.28812],"origin":[187.41733,473.99911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"12).","bbox":[187.41733,474.27411,206.37032,489.38812],"origin":[187.41733,486.09912],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Higher scores indicate more health anxiety and beliefs of negative","bbox":[187.41733,498.47409,508.39731,513.58807],"origin":[187.41733,510.2991],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"consequences of becoming ill. ","bbox":[187.41733,510.5741,337.82031,525.68811],"origin":[187.41733,522.39911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Two percentiles are computed that compares scores against two","bbox":[187.41733,534.77411,501.65436,549.88812],"origin":[187.41733,546.59912],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"samples (Salkovskis, Rimes, Warwick & Clark, 2002). ","bbox":[187.41733,546.87408,451.46133,561.9881],"origin":[187.41733,558.6991],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"  - A Normative Percentile compares the respondent's scores","bbox":[187.41733,571.0741,483.57034,586.18811],"origin":[187.41733,582.89911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"against patterns of responding in a community sample. A Normative","bbox":[187.41733,583.17413,517.54932,598.28815],"origin":[187.41733,594.99915],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Percentile of around 50 represents an average (and healthy) level of","bbox":[187.41733,595.27411,519.41931,610.38812],"origin":[187.41733,607.09912],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"concern about health. Higher percentiles indicate higher levels of","bbox":[187.41733,607.37408,502.89725,622.4881],"origin":[187.41733,619.1991],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"concern over health. Those with Illness Anxiety Disorder will","bbox":[187.41733,619.47412,479.62125,634.58813],"origin":[187.41733,631.29913],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"typically have a Normative Percentile above 99, indicating they","bbox":[187.41733,631.5741,492.4913,646.68811],"origin":[187.41733,643.39911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"score above 99% of the community. ","bbox":[187.41733,643.67413,365.33136,658.78815],"origin":[187.41733,655.49915],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"  - A Clinical Percentile is also computed, indicating how the","bbox":[187.41733,667.87408,477.8063,682.9881],"origin":[187.41733,679.6991],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"respondent scored in comparison to people who had been","bbox":[187.41733,679.97406,470.51328,695.08807],"origin":[187.41733,691.79907],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"independently assessed as having Health Anxiety Disorder","bbox":[187.41733,692.0741,474.15427,707.18811],"origin":[187.41733,703.89911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"(previously known as hypochondriasis).","bbox":[187.41733,704.17407,379.36728,719.28809],"origin":[187.41733,715.99908],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"If the SHAI is administered on more than one occasion, the total","bbox":[187.41733,728.37408,498.62936,743.4881],"origin":[187.41733,740.1991],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"score will be graphed over time with a dotted horizontal line","bbox":[187.41733,740.47412,475.98032,755.58813],"origin":[187.41733,752.29913],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"displayed at the community average score.  The SHAI is sensitive to","bbox":[187.41733,752.5741,519.38641,767.68811],"origin":[187.41733,764.39911],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 4","bbox":[467.71652,784.13007,523.98157,799.24408],"origin":[467.71652,795.95508],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[{"bbox":[187.41733,298.47296,521.24408,354.37201],"rows":[["","Score","NormativePercentile","ClinicalPercentile"],["Total (0 -54)","37","99 9\n.","44 7\n."],["Health Anxiety (0 -42)","29","-","-"],["Negative Consequences (0 -12)","8","-","-"]],"cells":[[187.41733,298.47296,314.64572,310.39377],[314.64572,298.47296,357.16531,310.39377],[357.16531,298.47296,442.20462,310.39377],[442.20462,298.47296,521.24408,310.39377],[187.41733,310.39377,314.64572,325.98434],[314.64572,310.39377,357.16531,325.98434],[357.16531,310.39377,442.20462,325.98434],[442.20462,310.39377,521.24408,325.98434],[187.41733,325.98434,314.