128.66396,302.14703],"font":"Helvetica","size":8.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"33","bbox":[145.56,299.95096,152.23199,305.95096],"origin":[145.56,304.58704],"font":"Helvetica","size":6.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"13","bbox":[279.06,395.58105,285.73199,401.58105],"origin":[279.06,400.21713],"font":"Helvetica","size":6.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"28","bbox":[412.56,323.86118,419.23199,329.86118],"origin":[412.56,328.49725],"font":"Helvetica","size":6.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Interpretation","bbox":[34.3465,493.0925,124.57652,507.0925],"origin":[34.3465,503.91],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The client’s score indicates a high level of life satisfaction, where individuals feel that most","bbox":[91.0394,512.34808,528.77344,523.34808],"origin":[91.0394,520.84753],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"areas of their life are functioning well. This score is higher than 71% of the general population.","bbox":[91.0394,524.44806,547.75952,535.44806],"origin":[91.0394,532.94751],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"These individuals generally experience contentment and positivity regarding their current life","bbox":[91.0394,536.54803,539.1684,547.54803],"origin":[91.0394,545.04749],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"situation, even if it is not without occasional challenges. Satisfaction in this category suggests","bbox":[91.0394,548.64807,544.08539,559.64807],"origin":[91.0394,557.14752],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"that the individual is likely to be having success in many areas of life and is maintaining","bbox":[91.0394,560.74811,514.11035,571.74811],"origin":[91.0394,569.24756],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"rewarding relationships and roles. People who are satisfied may draw motivation from small","bbox":[91.0394,572.84808,536.07745,583.84808],"origin":[91.0394,581.34753],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"areas of dissatisfaction, using them as opportunities to set new goals or make positive changes.","bbox":[91.0394,584.94806,556.92255,595.94806],"origin":[91.0394,593.44751],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Sustaining satisfaction often involves continuous personal growth and occasional adjustments to","bbox":[91.0394,597.0481,559.37537,608.0481],"origin":[91.0394,605.54755],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"keep an alignment between their values and day-to-day life experiences.","bbox":[91.0394,609.14813,443.82031,620.14813],"origin":[91.0394,617.64758],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[34.3464,636.57843,290.26636,650.57843],"origin":[34.3464,647.39594],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"For comprehensive information on the SWLS, ","bbox":[91.0393,655.83398,316.62732,666.83398],"origin":[91.0393,664.33344],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"see here","bbox":[316.62701,655.83453,359.42801,666.83453],"origin":[316.62701,664.33398],"font":"Helvetica","size":11.0,"colour":"#0000ff","direction":[1.0,0.0]},{"text":".","bbox":[359.42899,655.83453,362.487,666.83453],"origin":[359.42899,664.33398],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The SWLS consists of five items, and each is scored on a Likert scale ranging from 1 (“strongly","bbox":[91.03998,680.03455,553.21613,691.03455],"origin":[91.03998,688.534],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"disagree”) to 7 (“strongly agree”), and is presented in raw scores, with a total score range of 5","bbox":[91.03998,692.13458,545.89001,703.13458],"origin":[91.03998,700.63403],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"to 35. Higher scores indicate greater life satisfaction. The below range corresponds with the","bbox":[91.03998,704.23456,536.12195,715.23456],"origin":[91.03998,712.73401],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"following interpretive categories (Diener et al., 1985).","bbox":[91.03998,716.33459,348.41794,727.33459],"origin":[91.03998,724.83405],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 31–35 - percentiles = 85th+: Extremely Satisfied","bbox":[91.03998,740.53461,331.92892,751.53461],"origin":[91.03998,749.03406],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 26–30 - percentiles = 59th to 84th: Satisfied","bbox":[91.03998,752.63458,310.24796,763.63458],"origin":[91.03998,761.13403],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 2","bbox":[510.23697,809.92749,561.38708,819.92749],"origin":[510.23697,817.6543],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[{"bbox":[162.41922,219.23424,549.46729,245.03336],"rows":[["","","","Value","","","Percentile","","","Descriptor"],["Raw Score (5 -35)","","","28","","","71","","","Satisfied"]],"cells":[[162.41922,219.23424,263.59097,231.02371],[263.59097,219.23424,269.29099,231.02371],[269.29099,219.23424,274.991,231.02371],[274.991,219.23424,362.80399,231.02371],[362.80399,219.23424,368.50385,231.02371],[368.50385,219.23424,374.20401,231.02371],[374.20401,219.23424,476.18997,231.02371],[476.18997,219.23424,481.88998,231.02371],[481.88998,219.23424,487.59,231.02371],[487.59,219.23424,549.46729,231.02371],[162.41922,231.02371,263.59097,245.03336],[263.59097,231.02