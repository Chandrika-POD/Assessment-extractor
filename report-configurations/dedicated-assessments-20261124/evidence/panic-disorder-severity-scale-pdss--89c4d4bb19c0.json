rection":[1.0,0.0]},{"text":"2","bbox":[345.75894,542.05792,350.76294,551.05792],"origin":[345.75894,549.01202],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"3","bbox":[430.75891,542.05792,435.76291,551.05792],"origin":[430.75891,549.01202],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"4","bbox":[515.75885,542.05792,520.76288,551.05792],"origin":[515.75885,549.01202],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"7. Social Impairment","bbox":[91.2344,507.89792,173.26036,516.89795],"origin":[91.2344,514.85205],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"6. Work Impairment","bbox":[94.74456,459.8381,173.26053,468.8381],"origin":[94.74456,466.79224],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"5. Interoceptive Avoidance","bbox":[67.20436,411.76822,173.26035,420.76822],"origin":[67.20436,418.72235],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"4. Agoraphobic Avoidance","bbox":[68.20358,363.70801,173.26056,372.70801],"origin":[68.20358,370.66214],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"3. Anticipatory Anxiety","bbox":[84.22348,315.6478,173.26047,324.6478],"origin":[84.22348,322.60193],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"2. Distress During Panic","bbox":[76.73559,267.57791,173.26057,276.57791],"origin":[76.73559,274.53204],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"1. Panic Frequency","bbox":[95.72539,219.51811,173.26035,228.51811],"origin":[95.72539,226.47223],"font":"Helvetica","size":9.0,"colour":"#333333","direction":[1.0,0.0]},{"text":"Scoring and Interpretation Information","bbox":[34.3465,564.04871,290.26645,578.04871],"origin":[34.3465,574.85498],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"For comprehensive information on the PDSS, ","bbox":[91.0394,583.29303,315.4064,594.29303],"origin":[91.0394,591.79248],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"see here","bbox":[315.40601,583.29358,358.207,594.29358],"origin":[315.40601,591.79303],"font":"Helvetica","size":11.0,"colour":"#0000ff","direction":[1.0,0.0]},{"text":".","bbox":[358.207,583.29358,361.26501,594.29358],"origin":[358.207,591.79303],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The PDSS is a 7-item self-report measure assessing the severity of seven dimensions of panic","bbox":[91.039,607.49359,551.37805,618.49359],"origin":[91.039,615.99304],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"disorder: panic attack frequency, distress during attacks, anticipatory anxiety, agoraphobic","bbox":[91.039,619.59357,529.40002,630.59357],"origin":[91.039,628.09302],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"avoidance, interoceptive avoidance, work impairment, and social impairment. Each item is rated","bbox":[91.039,631.69354,556.87799,642.69354],"origin":[91.039,640.19299],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"on a 0 to 4 scale, where 0 represents no symptoms and 4 represents extreme severity. Higher","bbox":[91.039,643.79358,548.3421,654.79358],"origin":[91.039,652.29303],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"scores indicate greater severity of panic disorder symptoms. Individual items rated at the severe","bbox":[91.039,655.89362,557.49408,666.89362],"origin":[91.039,664.39307],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"(3) or extreme (4) level are highlighted as these ratings correspond to significant impairment in","bbox":[91.039,667.99359,549.54108,678.99359],"origin":[91.039,676.49304],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"daily functioning based on the scale's item-level descriptors. The PDSS is designed to measure","bbox":[91.039,680.09357,554.72211,691.09357],"origin":[91.039,688.59302],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"panic disorder symptom severity and is not intended as a diagnostic instrument.","bbox":[91.039,692.1936,478.646,703.1936],"origin":[91.039,700.69305],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 2 of 4","bbox":[510.23599,809.92725,561.38611,819.92725],"origin":[510.23599,817.65405],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[],"chartObservations":[{"id":"chart_1","title":"Responses","type":"horizontal_bar","bboxPt":[178.261,197.292,520.261,535.732],"widthPt":342.0,"heightPt":338.44,"axisColour":"#333333","xAxis":{"status":"linear_ticks_observed","ticks":[{"value":0.0,"positionPt":178.261,"text":"0","colour":"#333333"},{"value":1.0,"positionPt":263.26097,"text":"1","colour":"#333333"},{"value":2.0,"positionPt":348.26094,"text":"2","colour":"#333333"},{"value":3.0,"positionPt":433.26090999999997,"text":"3","colour":"#333333"},{"value":4.0,"positionPt":518.260865,"text":"4","colour":"#333333"}],"title":null,"minimum":0.0,"maximum":4.0,"coordinateFit":{"slope":0.011764710449828748,"offset":-2.097189084791051,"maximumResidual":7.058826501094018e-08}},"yAxis":{"status":"unresolved","ticks":[],"title":null},"observedDataType":"unresolved","labels":[{"text":"PDSS Item","bboxPt":[255.918,153.38954,316.60199,165.38954],"colour":"#000000","font":"Helvetica-Bold","fontSizePt":12.0,"direction":[1.0,0.0]},{"text":"Responses","bboxPt":[254.25003,165.38954,318.27002,177.38954],"colour":"#000000","font":"Helvetica-Bold","fontSizePt":12.0,"direction":[1.0,0.0]},{"text":"7. Social Impairment","bboxPt":[91.2344,507.89792,173.26036,516.89795],"colour":"#333333","font":"Helvetica","fontSizePt":9.0,"direction":[1.0,0.0]