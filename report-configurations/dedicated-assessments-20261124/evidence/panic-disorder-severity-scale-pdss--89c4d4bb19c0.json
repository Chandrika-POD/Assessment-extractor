equency","colour":"#4e79a7","sampleDrawingIndex":38,"sourceMarkBBoxPt":[178.261,206.29218,518.26099,240.35199],"categoryPosition":0.0769119932632077,"barThicknessPt":34.05981,"sampleValuePolicy":"evidence_only_never_runtime_input"}],"detection":{"method":"independent_axis_pair","reviewStatus":"machine_observed_not_visually_verified"},"sampleVisitCount":null,"variantEvidence":"single_visit_or_unspecified","drawingEvidence":{"axisDrawingIds":[40,42],"marks":[{"drawingIndex":32,"bboxPt":[178.261,494.67221,348.26099,528.73199],"colour":"#ff9da7","fill":"#ff9da7","stroke":"#000000","lineWidthPt":1.0},{"drawingIndex":33,"bboxPt":[178.261,446.60181,263.26099,480.66202],"colour":"#af7aa1","fill":"#af7aa1","stroke":"#000000","lineWidthPt":1.0},{"drawingIndex":34,"bboxPt":[178.261,398.54221,348.26099,432.60202],"colour":"#edc949","fill":"#edc949","stroke":"#000000","lineWidthPt":1.0},{"drawingIndex":35,"bboxPt":[178.261,350.48181,518.26099,384.54202],"colour":"#59a14f","fill":"#59a14f","stroke":"#000000","lineWidthPt":1.0},{"drawingIndex":36,"bboxPt":[178.261,302.42218,263.26099,336.48199],"colour":"#e15759","fill":"#e15759","stroke":"#000000","lineWidthPt":1.0},{"drawingIndex":37,"bboxPt":[178.261,254.35181,518.26099,288.41205],"colour":"#f28e2b","fill":"#f28e2b","stroke":"#000000","lineWidthPt":1.0},{"drawingIndex":38,"bboxPt":[178.261,206.29218,518.26099,240.35199],"colour":"#4e79a7","fill":"#4e79a7","stroke":"#000000","lineWidthPt":1.0}],"curves":[]}}]},{"pageId":"d13fa01802f43_p3","documentSha256":"13fa01802f43880002526ff4f4ed7bfa3aa0700de8cc766b47e4410de621acb0","pageNumber":3,"text":[{"text":"Client Name","bbox":[66.3844,116.32253,135.73239,128.32253],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Dummy Client","bbox":[147.73239,116.56485,216.79037,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Responses","bbox":[34.3465,144.0488,151.82051,158.0488],"origin":[34.3465,154.85504],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"1","bbox":[35.9047,168.35178,40.6307,176.85178],"origin":[35.9047,174.91956],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"How many panic and limited symptoms attacks did you have during the week?","bbox":[54.18905,168.35178,348.50177,176.85178],"origin":[54.18905,174.91956],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    No panic or limited symptom episodes","bbox":[51.1891,185.92526,208.96609,194.42526],"origin":[51.1891,192.49304],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Mild: no full panic attacks and no more than 1 limited symptom attack/day","bbox":[51.18907,199.95578,341.26025,208.45578],"origin":[51.18907,206.52356],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Moderate: 1 or 2 full panic attacks and/or multiple limited symptom attacks/day","bbox":[51.18907,214.12918,360.14722,222.62918],"origin":[51.18907,220.69696],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Severe: more than 2 full attacks but not more than 1/day on average","bbox":[51.18907,228.30258,321.92276,236.80258],"origin":[51.18907,234.87036],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"4    Extreme: full panic attacks occurred more than once a day, more days than not","bbox":[51.1891,242.45901,384.68689,250.95901],"origin":[51.1891,249.01996],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2","bbox":[35.9047,269.25687,40.6307,277.75687],"origin":[35.9047,275.82465],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"If you had any panic attacks during the past week, how distressing (uncomfortable, frightening) were they while they were happening? (If","bbox":[51.1891,259.90689,563.79059,268.40689],"origin":[51.1891,266.47467],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"you had more than one, give an average rating. If you didn't have any panic attacks but did have limited symptom attacks, answer for","bbox":[51.1891,269.25687,550.30957,277.75687],"origin":[51.1891,275.82465],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"the limited symptom attacks.)","bbox":[51.1891,278.60684,161.24712,287.10684],"origin":[51.1891,285.17462],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    Not at all distressing, or no panic or limited symptom attacks during the past week","bbox":[51.1891,296.18033,372.42981,304.68033],"origin":[51.1891,302.74811],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Mildly distressing (not too intense)","bbox":[51.18907,310.21085,193.85309,318.71085],"origin":[51.18907,316.77863],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Moderately distressing (intense, but still manageable)","bbox":[51.18907,324.38425,266.13708,332.88425],"origin":[51.18907,330.95203],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Severely distressing (very intense)","bbox":[51.18907,338.55765,195.26407,347.05765],"origin":[51.18907,345.12543],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"4    Extremely distressing (extreme distress during all attacks)","bbox":[51.1891,352.71451,301.56525,361.21451],"origin":[51.1891,359.27545],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3","bbox":[35.9047,374.83698,40.6307,383.33698],"origin":[35.9047,381.40475],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"During the past week, how much have you worried or felt anxious about when your next panic attack would occur or about fears related","bbox":[51.1891,365.48697,559.0647,373.98697],"origin":[51.1891,372.05475],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"to the attacks (for example, that they could mean you have physical or mental health problems or could cause you social","bbox":[51.1891,374.83698,503.31305,383.33698],"origin":[51.1891,381.40475],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"embarrassment)?","bbox":[51.1891,384.18698,117.78658,392.68698],"origin":[51.1891,390.75476],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    Not at all","bbox":[51.1891,397.08545,98.9081,405.58545],"origin":[51.1891,403.65323],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Occasionally or only mildly","bbox":[51.18907,411.24188,175.44208,419.74188],"origin":[51.18907,417.80283],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Frequently or moderately","bbox":[51.18907,425.28934,159.84454,433.78934],"origin":[51.18907,431.85712],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3     Very often or to a very disturbing degree","bbox":[51.18907,439.46234,219.38705,447.96234],"origin":[51.18907,446.03012],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"4    Nearly constantly and to a disabling extent","bbox":[51.1891,453.49277,225.05659,461.99277],"origin":[51.1891,460.06055],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"4","bbox":[35.9047,485.09116,40.6307,493.59116],"origin":[35.9047,491.65894],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"During the past week were there any places or situations (e.g., public transportation, movie theaters, crowds, bridges, tunnels, shopping","bbox":[51.1891,471.06616,561.41919,479.56616],"origin":[51.1891,477.63394],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"malls, being alone) you avoided, or felt afraid of (uncomfortable in, wanted to avoid or leave), because of fear of having a panic attack?","bbox":[51.1891,480.41617,557.1947,488.91617],"origin":[51.1891,486.98395],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Are there any other situations that you would have avoided or been afraid of if they had come up during the week, for the same reason?","bbox":[51.1891,489.76617,560.51819,498.26617],"origin":[51.1891,496.33395],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"If yes to either question, please rate your level of fear and avoidance this past week.  ","bbox":[51.1891,499.11618,371.99634,507.61618],"origin":[51.1891,505.68396],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    None: no fear or avoidance","bbox":[51.1891,516.6897,167.89406,525.1897],"origin":[51.1891,523.25745],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Mild: occasional fear and/or avoidance but I could usually confront or endure the situation. There was little or no modification of my","bbox":[51.1891,529.72595,555.2821,538.22601],"origin":[51.1891,536.29376],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"lifestyle due to this","bbox":[51.1891,539.07605,121.11009,547.57605],"origin":[51.1891,545.6438],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Moderate: noticeable fear and/or avoidance but still manageable. I avoided some situations, but I could confront them with a","bbox":[51.1891,551.26086,530.74261,559.76086],"origin":[51.1891,557.82861],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"companion. There was some modification of my lifestyle because of this, but my overall functioning was not impaired","bbox":[51.1891,560.61084,489.10953,569.11084],"origin":[51.1891,567.17859],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Severe: extensive avoidance. Substantial modification of my lifestyle was required to accommodate the avoidance making it difficult","bbox":[51.1891,572.79565,559.04755,581.29565],"origin":[51.1891,579.3634],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"to manage usual activities","bbox":[51.1891,582.14563,148.98157,590.64563],"origin":[51.1891,588.71338],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"4    Extreme: pervasive disabling fear and/or avoidance. Extensive modification in my lifestyle was required such that","bbox":[51.1891,594.31342,524.06165,602.81342],"origin":[51.1891,600.87433],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"important tasks were not performed","bbox":[51.1891,603.66345,196.1906,612.16345],"origin":[51.1891,610.22437],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"5","bbox":[35.9047,638.81677,40.6307,647.31677],"origin":[35.9047,645.38452],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"During the past week, were there any activities (e.g., physical exertion, sexual relations, taking a hot shower or bath, drinking coffee,","bbox":[51.1891,620.11682,547.71704,628.61682],"origin":[51.1891,626.68457],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"watching an exciting or scary movie) that you avoided, or felt afraid of (uncomfortable doing, wanted to avoid or stop), because they","bbox":[51.1891,629.4668,544.89514,637.9668],"origin":[51.1891,636.03455],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"caused physical sensations like those you feel during panic attacks or that you were afraid might trigger a panic attack? Are there any","bbox":[51.1891,638.81677,552.45154,647.31677],"origin":[51.1891,645.38452],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"other activities that you would have avoided or been afraid of if they had come up during the week for that reason? If yes to either","bbox":[51.1891,648.16675,536.42065,656.66681],"origin":[51.1891,654.73456],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"question, please rate your level of fear and avoidance of those activities this past week.","bbox":[51.1891,657.51685,379.07678,666.01685],"origin":[51.1891,664.08459],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    No fear or avoidance of situations or activities because of distressing physical sensations","bbox":[51.1891,675.09033,399.84232,683.59033],"origin":[51.1891,681.65808],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Mild: occasional fear and/or avoidance, but usually I could confront or endure with little distress activities that cause physical","bbox":[51.1891,688.12659,531.17609,696.62659],"origin":[51.1891,694.69434],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"sensations. There was little modification of my lifestyle due to this","bbox":[51.1891,697.47656,296.83917,705.97662],"origin":[51.1891,704.04437],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Moderate: noticeable avoidance but still manageable. There was definite, but limited, modification of my lifestyle such that","bbox":[51.1891,709.78735,559.44708,718.28735],"origin":[51.1891,716.34827],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"my overall functioning was not impaired","bbox":[51.1891,719.13733,213.67511,727.63733],"origin":[51.1891,725.69824],"font":"Helvetica-BoldOblique","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Severe: extensive avoidance. There was substantial modification of my lifestyle or interference in my functioning","bbox":[51.18907,732.19031,486.28745,740.69031],"origin":[51.18907,738.75806],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"4    Extreme: pervasive and disabling avoidance. There was extensive modification in my lifestyle due to this such that important tasks or","bbox":[51.1891,745.22656,563.76489,753.72662],"origin":[51.1891,751.79437],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"activities were not performed","bbox":[51.1891,754.57654,159.83611,763.0766],"origin":[51.1891,761.14435],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 3 of 4","bbox":[510.23608,809.92773,561.38617,819.92773],"origin":[510.23608,817.65454],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[],"chartObservations":[]},{"pageId":"d13fa01802f43_p4","documentSha256":"13fa01802f43880002526ff4f4ed7bfa3aa0700de8cc766b47e4410de621acb0","pageNumber":4,"text":[{"text":"Client Name","bbox":[66.3844,116.32253,135.73239,128.32253],"origin":[66.3844,125.58502],"font":"Helvetica-Bold","size":12.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Dummy Client","bbox":[147.73239,116.56485,216.79037,127.56485],"origin":[147.73239,125.06433],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Client Responses (cont.)","bbox":[34.3465,144.0488,198.48251,158.0488],"origin":[34.3465,154.85504],"font":"Helvetica-Bold","size":14.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"6","bbox":[35.9047,177.70175,40.6307,186.20175],"origin":[35.9047,184.26953],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"During the past week, how much did the above symptoms altogether (panic and limited symptom attacks, worry about attacks, and fear","bbox":[54.1891,163.67673,561.57153,172.17673],"origin":[54.1891,170.24451],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"of situations and activities because of attacks) interfere with your ability to work or carry out your responsibilities at home?  (If your work","bbox":[54.1891,173.0267,562.4895,181.5267],"origin":[54.1891,179.59448],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"or home responsibilities were less than usual this past week, answer how you think you would have done if the responsibilities had","bbox":[54.1891,182.37668,544.09558,190.87668],"origin":[54.1891,188.94446],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"been usual.)","bbox":[54.1891,191.72665,100.96459,200.22665],"origin":[54.1891,198.29443],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"0    No interference with work or home responsibilities","bbox":[51.1891,204.62515,252.89407,213.12515],"origin":[51.1891,211.19293],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"1    Slight interference with work or home responsibilities, but I could do nearly everything I could if I didn't have these problems","bbox":[51.1891,218.81856,563.92969,227.22717],"origin":[51.1891,225.30896],"font":"Helvetica-BoldOblique","size":8.40861988067627,"colour":"#000000","direction":[1.0,0.0]},{"text":"2    Significant interference with work or home responsibilities, but I still could manage to do the things I needed to do","bbox":[51.18907,232.82907,490.09555,241.32907],"origin":[51.18907,239.39685],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"3    Substantial impairment in work or home responsibilities; there were many important things I couldn't do because of these problems","bbox":[51.18907,247.00204,555.93671,255.50204],"origin":[51.18907,253.56982],"font":"Helvetica","size":8.5,"colour":"#000000","direction":[1.0,0.0]},{"text":"4    Extreme, incapacitating impairment such that I 