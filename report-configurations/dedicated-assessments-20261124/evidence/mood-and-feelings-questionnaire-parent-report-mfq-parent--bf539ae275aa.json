:[91.0394,569.44855,169.92036,580.44855],"origin":[91.0394,577.948],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The parent rated their child with a total score of 15 out of a possible 26. This indicates elevated","bbox":[91.0394,593.64856,552.04956,604.64856],"origin":[91.0394,602.14801],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"depressive symptoms based on parent observation. Parents of young people scoring in this","bbox":[91.0394,605.7486,535.5274,616.7486],"origin":[91.0394,614.24805],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"range are observing a notable level of depression that is likely impacting their child's emotional","bbox":[91.0394,617.84857,550.44348,628.84857],"origin":[91.0394,626.34802],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"well-being and daily activities. Parents may notice persistent low mood, reduced enjoyment in","bbox":[91.0394,629.94861,545.27344,640.94861],"origin":[91.0394,638.44806],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"previously pleasurable activities, negative thoughts or self-statements, difficulties with","bbox":[91.0394,642.04858,506.14642,653.04858],"origin":[91.0394,650.54803],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"concentration or energy, increased tearfulness, or changes in their child's behaviour and","bbox":[91.0394,654.14862,519.89636,665.14862],"origin":[91.0394,662.64807],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"engagement. This level of symptoms warrants further clinical evaluation to determine the","bbox":[91.0394,666.2486,522.04138,677.2486],"origin":[91.0394,674.74805],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"appropriate level of support and intervention.","bbox":[91.0394,678.34863,308.70737,689.34863],"origin":[91.0394,686.84808],"font":"Helvetica","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"The following items were endorsed at the highest levels by the parent:","bbox":[91.0394,702.54865,431.58844,713.54865],"origin":[91.0394,711.0481],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 2. They didn’t enjoy anything at all. (True)","bbox":[91.0394,714.64862,300.12735,725.64862],"origin":[91.0394,723.14807],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 5. They felt they were no good anymore. (True)","bbox":[91.0394,726.7486,327.63834,737.7486],"origin":[91.0394,735.24805],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 12. They thought they could never be as good as other kids. (True)","bbox":[91.0394,738.84863,423.04141,749.84863],"origin":[91.0394,747.34808],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"- 1. They felt miserable or unhappy. (Sometimes)","bbox":[91.0394,750.94861,329.45334,761.94861],"origin":[91.0394,759.44806],"font":"Helvetica-Oblique","size":11.0,"colour":"#000000","direction":[1.0,0.0]},{"text":"Page 1 of 3","bbox":[510.23639,809.92743,561.38647,819.92743],"origin":[510.23639,817.65424],"font":"Helvetica","size":10.0,"colour":"#000000","direction":[1.0,0.0]}],"tables":[{"bbox":[28.3465,113.38562,566.92941,180.0],"rows":[["Mood and Feelings Questionnaire-Parent Report (MFQ -Parent)",null,null,null],["Client Name","Generic Client","Date administered","2 Oct 2025"],["Date of birth (age)","1 Jan 1999 (26)","Time taken","1 min 53s"],["Assessor","Dr Emerson Bartholomew","",""]],"cells":[[28.3465,113.38562,566.92941,133.22818],[28.3465,133.22818,141.73212,148.81921],[28.3465,148.81921,141.73212,164.40973],[28.3465,164.40973,141.73212,180.0],[141.73212,133.22818,354.33051,148.81921],[141.73212,148.81921,354.33051,164.40973],[141.73212,164.40973,354.33051,1